---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us — CopyMonster',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About us"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Strategy Team',
    }}
  >
    <Fragment slot="title">
      Empowering Brands in the <br />
      <span class="text-accent dark:text-white"> AI & Agentic Era</span>
    </Fragment>

    <Fragment slot="subtitle">
      CopyMonster is the culmination of 15+ years of strategic digital marketing. We believe that in a world where execution is automated, your unique Brand DNA is your most valuable asset.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Global Reach & Community"
    stats={[
      { title: 'Countries', amount: '132' },
      { title: 'Community Members', amount: '21K+' },
      { title: 'Brand DNA Blocks', amount: '12' },
      { title: 'Open Source', amount: 'MIT' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Strategic Pillars"
    subtitle="CopyMonster is the architectural layer where your brand voice is defined before a single line of copy is born."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'DNA-First Framework',
        description:
          'The fundamental rule: No DNA → No Copy. We force the mapping of 12 strategic blocks to ensure authenticity.',
        icon: 'tabler:dna',
      },
      {
        title: 'Multi-Agent Authority',
        description:
          'Specialized AI agents trained on your unique identity, ensuring every touchpoint sounds exactly like your brand.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Real-World Evolution',
        description:
          'Performance metrics from Meta Ads feed back into your adaptive DNA layer, making your identity smarter over time.',
        icon: 'tabler:refresh',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="The Monster Values"
    subtitle="Built in the digital trenches, we value strategic depth over surface-level automation."
    items={[
      {
        title: 'Strategy over generic prompts',
        description:
          'Prompts are commodities. Strategy is your moat. We prioritize mapping the Brand DNA to save months of wasted execution.',
      },
      {
        title: 'Identity over volume',
        description:
          'Generating 1,000 posts is useless if they don\'t sound like you. We never sacrifice voice integrity for scale.',
      },
      {
        title: 'Transparency over black boxes',
        description:
          'Our Open Core (MIT) model allows you to audit every strategic prompt and self-host your brand intelligence infrastructure.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="The Journey"
    subtitle="From reverse-engineering high-performance funnels to building global AI infrastructure."
    isReversed={true}
    callToAction={{
      text: 'Launch DNA Engine',
      href: 'https://app.copymonster.co',
    }}
    items={[
      {
        title: '11+ Years of Digital Mastery',
        description: 'Founder Adriano Vieira builds a legacy of conversion, communities (21K+ members), and strategic funnels.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Visionary Reach (132 Countries)',
        description: 'What started as a digital strategy practice evolved into a global brand intelligence platform.',
        icon: 'tabler:globe',
      },
      {
        title: 'Open Core Revolution',
        description: 'Releasing the DNA Engine as MIT licensed code to decentralize the power of strategic marketing.',
        icon: 'tabler:brand-github',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Strategic Support"
    tagline="Get in Touch"
    columns={2}
    items={[
      {
        title: 'DNA Strategy',
        description:
          'Need help mapping your 12 strategic blocks? Our Legend tier offers direct access.',
        icon: 'tabler:messages',
      },
      {
        title: 'Technical Support',
        description:
          'Issues with deployment or self-hosting? Reach out to our core team.',
        icon: 'tabler:headset',
      },
    ]}
  />
</Layout>
