---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About CopyMonster — Identity-First AI Architecture',
  description: 'Learn why CopyMonster was built to solve the identity crisis in generative AI and empower creators with deterministic Brand DNA.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget -->
  <HeroText
    tagline="Our Mission"
    title="The Future of AI Copywriting is Identity"
    subtitle="We believe AI shouldn't replace human creativity — it should preserve, amplify, and execute your brand's distinct intellectual property with uncompromising fidelity."
    callToAction={{
      variant: 'primary',
      text: 'Free Trial',
      href: 'https://app.copymonster.co/',
      target: '_blank',
      icon: 'tabler:rocket',
    }}
    callToAction2={{
      text: 'Explore Brand DNA',
      href: getPermalink('/dna'),
    }}
  />

  <!-- Content Widget 1: The Identity Crisis -->
  <Content
    isReversed
    tagline="The Problem"
    title="Why Generic AI is Poisoning Brand Authority"
    items={[
      {
        title: 'The Sameness Epidemic',
        description: 'Millions of companies are using the same foundational models with generic prompts, flooding markets with indistinguishable copy.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'The Context Erosion Loop',
        description: 'Every time you open a new chat window, your brand history is wiped clean, forcing you to start from scratch.',
        icon: 'tabler:refresh-off',
      },
      {
        title: 'Direct Response Dilution',
        description: 'Generic AI models are trained on academic prose and generic corporate blogs, not conversion mechanisms.',
        icon: 'tabler:trending-down',
      },
    ]}
    image={{
      src: '/images/site/ai-system-to-buy-back-time.jpg',
      alt: 'AI System to Buy Back Time',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-3">
        The AI Identity Crisis
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed mb-4">
        Without structured memory and voice constraints, AI produces vanilla, sycophantic content that kills buyer trust. CopyMonster was founded to restore your brand moat.
      </p>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed">
        Instead of treating AI like a novelty chatbot, we treat it as an autonomous execution engine that reports to your permanent brand architecture.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[var(--cm-secondary)]/30 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget 2: What is Brand DNA -->
  <Content
    tagline="The Solution"
    title="What is Brand DNA in AI?"
    items={[
      {
        title: 'Structured Strategy Blocks',
        description: 'Origin, pain points, core mechanisms, tone boundaries, proof stacks, and objection triggers codified into persistent schema.',
        icon: 'tabler:dna',
      },
      {
        title: 'Deterministic Orchestration',
        description: 'Autonomous agents read from this schema before generating a single syllable, ensuring mathematical consistency.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Zero Prompt Drift',
        description: 'Your copy never degrades over long sequences or campaigns. Every asset aligns with your founding thesis.',
        icon: 'tabler:shield-check',
      },
    ]}
    image={{
      src: '/images/site/brand-voice-consistency-in-ai-writing.jpg',
      alt: 'Brand Voice Consistency in AI Writing',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-3">
        Preserving Your Strategic Soul
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed mb-4">
        Brand DNA is not just a system prompt. It is a living, versioned operating system that gives AI agents permanent, immutable context about who you are and how you sell.
      </p>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed">
        With our 12-block framework, every agent operates with full situational awareness of your target audience, mechanisms, and promises.
      </p>
    </Fragment>
  </Content>

  <!-- Content Widget 3: Systematic Scale -->
  <Content
    isReversed
    tagline="The Architecture"
    title="Engineered to Give Founders Their Time Back"
    items={[
      {
        title: 'Single Source of Truth',
        description: 'Update a positioning block once and every sales page, email campaign, and ad script inherits the change instantly.',
        icon: 'tabler:database',
      },
      {
        title: 'Multi-Tenant Isolation',
        description: 'Every organization runs in a partitioned database enclave with strict Row-Level Security.',
        icon: 'tabler:lock',
      },
    ]}
    image={{
      src: '/images/site/how-to-build-a-brand-dna.jpg',
      alt: 'How to Build a Brand DNA',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-3">
        From Prompt Chaos to Systemic Execution
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed">
        We built CopyMonster so founders and copy chiefs no longer have to spend hours prompting and correcting output. You set the strategic foundation, and the multi-agent system does the heavy lifting.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[var(--cm-secondary)]/30 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget: Our Core Values -->
  <Steps
    tagline="Core Principles"
    title="Our Engineering & Ethical Commitments"
    subtitle="What guides every line of code we write at CopyMonster."
    items={[
      {
        title: '1. <span class="font-medium">Complete Tenant Data Isolation</span>',
        description: 'We believe your strategic positioning is proprietary IP. Your Brand DNA is strictly isolated via Row-Level Security and never used to train public models.',
        icon: 'tabler:shield-lock',
      },
      {
        title: '2. <span class="font-medium">Open Source Core (MIT)</span>',
        description: 'Transparency over black boxes. We maintain an open core architecture so the community can inspect, extend, and audit our tooling.',
        icon: 'tabler:brand-github',
      },
      {
        title: '3. <span class="font-medium">Performance Over Fluff</span>',
        description: 'We measure success in opt-in rates, click-throughs, and revenue generated, not vanity word counts or arbitrary token consumption.',
        icon: 'tabler:chart-line',
      },
      {
        title: '4. <span class="font-medium">Buy Back Founder Time</span>',
        description: 'Our ultimate metric is giving founders, solopreneurs, and copy chiefs their freedom back through deterministic multi-agent automation.',
        icon: 'tabler:clock',
      },
    ]}
  />

  <!-- Features2 Widget: Global Impact -->
  <Features2
    tagline="Worldwide Presence"
    title="Built for Modern Operators Globally"
    subtitle="From boutique agencies in São Paulo to high-ticket consulting firms in Silicon Valley."
    columns={3}
    items={[
      {
        title: 'Operators in 30+ Countries',
        description: 'Used daily by infopreneurs, media buyers, and marketing teams worldwide.',
        icon: 'tabler:world',
      },
      {
        title: 'Over 21,000 Campaigns Launched',
        description: 'Billions of direct response impressions tested across paid traffic and email.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'Enterprise Multi-Tenant Security',
        description: 'SOC2-ready cloud architecture with granular workspace controls and audit logs.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- CallToAction Widget -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      {
        text: 'View Pricing',
        href: getPermalink('/pricing'),
      },
    ]}
    title="Join the Identity-First AI Revolution"
    subtitle="Lock your Brand DNA into the world's most powerful direct response copywriting engine."
  />
</Layout>
