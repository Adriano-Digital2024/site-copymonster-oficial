---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'AI Agents — Specialized Brand Operators — CopyMonster',
  description: 'A conceptual overview of specialized AI agent roles and how a shared Brand DNA can guide their work.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget *************** -->

  <HeroText
    tagline="Conceptual Roles"
    title="Different AI Roles, Guided by the Same Brand DNA"
    subtitle="Specialized agent roles can focus on different marketing tasks while referring to one shared brand foundation."
    callToAction={{
      variant: 'primary',
      text: 'Start 7-Day Free Trial',
      href: 'https://app.copymonster.co/',
      target: '_blank',
      icon: 'tabler:robot',
    }}
    callToAction2={{
      text: 'See How It Works',
      href: getPermalink('/dna'),
    }}
  />

  <!-- Features2 Widget (Agents Roster) -->

  <Features2
    tagline="Types of Work"
    title="Common Marketing Agent Roles"
    subtitle="These are conceptual examples of roles, not a technical catalog of available products or integrations."
    columns={3}
    items={[
      {
        title: 'Copywriting Assistant',
        description: 'Helps shape drafts and ideas around a brand’s positioning, audience, and offer context.',
        icon: 'tabler:article',
      },
      {
        title: 'Campaign Planning Assistant',
        description: 'Helps organize campaign messages and milestones around a consistent brand narrative.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Content Research Assistant',
        description: 'Helps structure research and explanations so content is clear, specific, and grounded in supplied information.',
        icon: 'tabler:search',
      },
      {
        title: 'Email Writing Assistant',
        description: 'Helps draft email communications that reflect the brand’s voice and customer context.',
        icon: 'tabler:mail',
      },
      {
        title: 'Advertising Copy Assistant',
        description: 'Helps explore ad messages and creative angles consistent with the brand’s positioning.',
        icon: 'tabler:ad',
      },
      {
        title: 'Brand Consistency Reviewer',
        description: 'Helps review drafts against documented brand principles, voice, and supporting evidence.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- Content Widget (Why Multi-Agent) -->

  <Content
    isReversed
    tagline="Shared Brand Foundation"
    title="Why Shared Context Matters Across Different Tasks"
    items={[
      {
        title: 'Unified Positioning Across Channels',
        description:
          'When different marketing roles refer to the same Brand DNA, teams have a clearer basis for maintaining a consistent narrative.',
        icon: 'tabler:arrows-join-2',
      },
      {
        title: 'Deep Domain Specialization',
        description:
          'Different tasks call for different perspectives; naming the role can help teams give an AI task clearer boundaries.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Continuous Strategic Feedback',
        description:
          'Teams can review campaign learnings and decide whether those insights should inform future brand or messaging decisions.',
        icon: 'tabler:refresh',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Multi-Agent Collaboration',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Specialization With Shared Context</h3>
      A conceptual agent roster separates kinds of work while keeping a shared Brand DNA as the common reference.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start 7-Day Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      {
        text: 'See How It Works',
        href: getPermalink('/dna'),
      },
    ]}
  >
    <Fragment slot="title">
      Explore a Brand-Guided Workflow
    </Fragment>

    <Fragment slot="subtitle">
      Use your Brand DNA as a shared reference for specialized marketing tasks.
    </Fragment>
  </CallToAction>
</Layout>
