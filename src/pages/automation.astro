---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Marketing Operations & AI Funnel Automation — CopyMonster',
  description: 'Use structured Brand DNA as a deterministic reference for recurring marketing content, email workflows, and automated funnels.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget -->
  <HeroText
    tagline="Marketing Automation"
    title="Autonomous AI Funnels Anchored to Your Brand DNA"
    subtitle="Bring deterministic brand context into recurring content, automated email sequences, and 24/7 revenue funnels without losing positioning integrity."
    callToAction={{
      variant: 'primary',
      text: 'Free Trial',
      href: 'https://app.copymonster.co/',
      target: '_blank',
      icon: 'tabler:settings-automation',
    }}
    callToAction2={{
      text: 'See Connectors',
      href: getPermalink('/integrations'),
    }}
  />

  <!-- Content Widget 1: Funnel Automation Overview (Balanced 2-Column) -->
  <Content
    tagline="Funnel Automation"
    title="Autonomous Pipelines Operating With Brand Precision"
    items={[
      {
        title: 'Behavioral Triggers',
        description: 'Trigger dynamic copy calibrated to user actions, cart abandonment, and lead qualification stages.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Zero Robotic Phrasing',
        description: 'Brand DNA filters out overused AI clichés and injects your authentic syntax and conversational markers.',
        icon: 'tabler:writing',
      },
      {
        title: 'High Deliverability Syntax',
        description: 'Formatted and structured to maintain pristine sender reputation and inbox engagement rates.',
        icon: 'tabler:inbox',
      },
    ]}
    image={{
      src: '/images/site/ai-funnel-automation.jpg',
      alt: 'AI Funnel Automation System',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-3">
        Nurture Leads on Autopilot
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed mb-4">
        Build evergreen relationship-building machines that sound exactly like your best salesperson, running every hour of every day.
      </p>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed">
        Because every sequence draws from your immutable Brand DNA, your messaging never drifts or loses psychological punch over time.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[var(--cm-secondary)]/30 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget 2: Email Sequences with Brand Voice -->
  <Content
    isReversed
    tagline="Lifecycle Marketing"
    title="Automate Email Sequences With Uncompromising Brand Voice"
    items={[
      {
        title: 'Soap Opera Storytelling',
        description: 'Multi-day narrative arcs that create emotional buy-in before presenting high-ticket or evergreen offers.',
        icon: 'tabler:heart-handshake',
      },
      {
        title: 'Dynamic Risk Reversals',
        description: 'Inject specific guarantees and proof stacks based on target segment hesitation patterns.',
        icon: 'tabler:shield-check',
      },
    ]}
    image={{
      src: '/images/site/automate-email-sequences-with-brand-voice.jpg',
      alt: 'Automate Email Sequences With Brand Voice',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-3">
        Authentic Relationship Scale
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed mb-4">
        Stop blasting generic newsletters. CopyMonster crafts highly personal, contextual sequences that turn subscribers into loyal advocates.
      </p>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed">
        Maintain authentic founder voice while generating dozens of nurture assets effortlessly.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[var(--cm-secondary)]/30 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget 3: Best AI Funnel Builder -->
  <Content
    tagline="Funnel Architecture"
    title="The Best AI Funnel Builder for Digital Products"
    items={[
      {
        title: 'Complete Direct Response Frameworks',
        description: 'Generate VSLs, lead magnets, qualification quizzes, order bumps, and 1-click upsells in minutes.',
        icon: 'tabler:stack-2',
      },
      {
        title: 'Continuous Optimization Loops',
        description: 'Integrate real conversion benchmarks back into your Brand DNA to constantly refine copy angles.',
        icon: 'tabler:refresh',
      },
    ]}
    image={{
      src: '/images/site/best-ai-funnel-builder-for-info-products.jpg',
      alt: 'Best AI Funnel Builder for Info Products',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-3">
        Architectures That Convert
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed mb-4">
        Stop assembling funnels from fragmented pieces. CopyMonster gives you end-to-end alignment across every step of your buyer journey.
      </p>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed">
        Every headline, bullet, guarantee, and call-to-action works in unison to maximize lifetime customer value.
      </p>
    </Fragment>
  </Content>

  <!-- Features Widget: Automated Workflows -->
  <Features
    tagline="Capabilities"
    title="Automated Workflows Powered by Brand DNA"
    subtitle="Scale repeatable marketing outputs without increasing operational overhead."
    items={[
      {
        title: 'Evergreen Email Welcome Series',
        description: '7 to 14-day onboarding sequences that introduce your origin story and core transformation.',
        icon: 'tabler:mail-fast',
      },
      {
        title: 'Webinar & Event Registration Funnels',
        description: 'High-attendance invitation pages, SMS reminders, and replay recap emails.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Customer Retention & Upsell Flows',
        description: 'Nurture existing buyers and introduce complementary high-ticket backend offers.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: 'Weekly Content Pipeline Generation',
        description: 'Transform key strategic insights into newsletters, social threads, and community posts.',
        icon: 'tabler:news',
      },
    ]}
  />

  <!-- FAQs Widget -->
  <FAQs
    title="Frequently Asked Questions"
    subtitle="Everything you need to know about autonomous marketing with CopyMonster."
    items={[
      {
        title: 'Can I connect CopyMonster to webhook automations?',
        description: 'Yes. CopyMonster can dispatch generated campaign copy to automated webhooks, Zapier, n8n, or directly into your marketing stack.',
      },
      {
        title: 'Does automation dilute brand voice?',
        description: 'No. Because all generation is constrained by your persistent Brand DNA rules, tone and vocabulary remain strictly uniform across every automated step.',
      },
    ]}
  />

  <!-- CallToAction Widget -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      {
        text: 'View Integrations',
        href: getPermalink('/integrations'),
      },
    ]}
    title="Put Your High-Converting Funnel on Autopilot"
    subtitle="Experience autonomous marketing with the intelligence and voice of a master copywriter."
  />
</Layout>
