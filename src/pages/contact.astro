---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Connect with the Monster!" />

  <ContactUs
    id="form"
    title="Scale your Brand Intelligence"
    subtitle="Have questions about Brand DNA, Multi-agent AI, or Enterprise solutions? Our strategic team is ready to help you unlock the next level of your business identity."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to our privacy policy regarding the collection of business data.',
    }}
    description="Our strategic agents typically respond within 24 business hours."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="We are here to help!"
    items={[
      {
        title: 'Strategic Support',
        description: `Inquiries related to DNA Map building, agent orchestration, and strategic alignment for your brand.`,
      },
      {
        title: 'Enterprise Sales',
        description:
          'Inquiries about white-label solutions, SSO, custom agent training, and agency-level scaling.',
      },
      {
        title: 'Technical Support',
        description:
          'Issues regarding App deployment, API integrations (Meta/Instagram), or Open Core self-hosting.',
      },
      {
        title: 'WhatsApp VIP',
        description: 'Exclusive for Legend Monster members.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Email',
        description: 'contact@bruxus.me',
        icon: 'tabler:mail',
      },
      {
        title: 'Global Vision',
        description: 'Active in 132 countries. Digital-first and decentralized.',
        icon: 'tabler:world',
      },
    ]}
  />
</Layout>
