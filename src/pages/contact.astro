---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Connect with the Monster!" />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h2 class="text-3xl font-bold mb-4">Scale your Brand Intelligence</h2>
      <p class="text-muted">Have questions about Brand DNA, Multi-agent AI, or Enterprise solutions? Our strategic team is ready to help you unlock the next level of your business identity.</p>
    </div>
    
    <div class="flex flex-col max-w-xl mx-auto rounded-lg backdrop-blur border border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl p-6 sm:p-8 lg:p-10 w-full">
      <div class="mautic-form-container text-left">
        <script is:inline type="text/javascript" src="https://mautic.integridadedigital.com.br/form/generate.js?id=1"></script>
      </div>
      <p class="mt-6 text-sm text-muted text-center border-t border-gray-100 dark:border-slate-800 pt-4 italic">
        Our strategic agents typically respond within 24 business hours.
      </p>
    </div>
  </section>

  <!-- Features2 Widget ************** -->

  <Features2
    title="We are here to help!"
    items={[
      {
        title: 'Strategic Support',
        description: `Inquiries related to DNA Map building, agent orchestration, and strategic alignment for your brand.`,
      },
      {
        title: 'Enterprise Sales',
        description:
          'Inquiries about white-label solutions, SSO, custom agent training, and agency-level scaling.',
      },
      {
        title: 'Technical Support',
        description:
          'Issues regarding App deployment, API integrations (Meta/Instagram), or Open Core self-hosting.',
      },
      {
        title: 'WhatsApp VIP',
        description: 'Exclusive for Legend Monster members.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Email',
        description: 'contato@copymonster.me',
        icon: 'tabler:mail',
      },
      {
        title: 'Global Vision',
        description: 'Active in 132 countries. Digital-first and decentralized.',
        icon: 'tabler:world',
      },
    ]}
  />
</Layout>
