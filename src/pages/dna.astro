---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Brand DNA Engine — 12-Block Strategic Architecture — CopyMonster',
  description: 'Explore the 12-block Brand DNA architecture that transforms brand identity into immutable structured memory for AI agents.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget -->
  <HeroText
    tagline="Brand DNA Engine"
    title="The 12-Block Strategic Architecture That Makes AI Sound Like You"
    subtitle="A deterministic framework that turns brand positioning into immutable structured memory. Stop prompt degradation, context loss, and generic robotic copy."
    callToAction={{
      variant: 'primary',
      text: 'Free Trial',
      href: 'https://app.copymonster.co/',
      target: '_blank',
      icon: 'tabler:dna',
    }}
    callToAction2={{
      text: 'View AI Agents',
      href: getPermalink('/agents'),
    }}
  />

  <!-- Content Widget 1: Persistent Memory Layer (Balanced 2-Column) -->
  <Content
    isReversed
    tagline="Persistent Memory Layer"
    title="Why Prompts Fail and Brand DNA Succeeds"
    items={[
      {
        title: 'Zero Prompt Drift',
        description:
          'Prompting an LLM on every session introduces variance and dilution. Brand DNA locks your positioning in structured schemas that never fade.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Immutable Versioning (v1, v2, v3)',
        description:
          'Every evolution of your brand strategy is saved as an immutable release. Roll back or compare variations with complete auditability.',
        icon: 'tabler:git-branch',
      },
      {
        title: 'Cross-Agent Inheritance',
        description:
          'All specialized agents — copywriters, funnel architects, and analytics loopers — draw from the same single source of truth.',
        icon: 'tabler:hierarchy-2',
      },
    ]}
    image={{
      src: '/images/site/12-block-brand-positioning-framework.jpg',
      alt: '12-Block Brand Positioning Framework',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-3">
        Determinism Over Randomness
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed mb-4">
        Generative AI requires strategic constraints. Without persistent memory, your marketing communications lose nuance, authority, and emotional resonance.
      </p>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed">
        With our structured 12-block model, agents know your counter-intuitive viewpoints, your taboo phrases, and your core mechanisms before generating a word.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[var(--cm-secondary)]/30 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget: The 12 Blocks -->
  <Steps
    tagline="The Strategic Matrix"
    title="The 12 Blocks of Brand DNA"
    subtitle="Structured into three critical operational phases to capture the full spectrum of your business identity."
    items={[
      {
        title: 'Block 1: <span class="font-medium">Origin & Core Mission</span>',
        description: 'The foundational narrative, reason for existence, and long-term vision of the enterprise.',
        icon: 'tabler:compass',
      },
      {
        title: 'Block 2: <span class="font-medium">Non-Negotiable Values</span>',
        description: 'Ethical boundaries, positioning stances, and principles that the brand will never violate.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Block 3: <span class="font-medium">Primary Value Proposition</span>',
        description: 'The distinct statement of tangible transformation and category authority.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Block 4: <span class="font-medium">Ideal Customer Profile (ICP)</span>',
        description: 'Demographics, psychographics, sophistication level, and operational realities of your best buyers.',
        icon: 'tabler:user-search',
      },
      {
        title: 'Block 5: <span class="font-medium">Core Pain Points & Friction</span>',
        description: 'The acute financial, psychological, and operational struggles your ICP faces daily.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'Block 6: <span class="font-medium">Transformation Promise</span>',
        description: 'The precise before-and-after state achieved after adopting your solution.',
        icon: 'tabler:sparkles',
      },
      {
        title: 'Block 7: <span class="font-medium">Tone of Voice & Vocabulary Rules</span>',
        description: 'Formal syntax guidelines, forbidden buzzwords, cadence constraints, and stylistic signatures.',
        icon: 'tabler:speakerphone',
      },
      {
        title: 'Block 8: <span class="font-medium">Contrarian & Counter-Intuitive Beliefs</span>',
        description: 'Unique industry viewpoints that challenge consensus and generate distinctive category leadership.',
        icon: 'tabler:flame',
      },
      {
        title: 'Block 9: <span class="font-medium">Product & Offer Architecture</span>',
        description: 'Deliverables, mechanism names, pricing tier hierarchy, and deliverable commitments.',
        icon: 'tabler:box',
      },
      {
        title: 'Block 10: <span class="font-medium">Proof Elements & Authority Assets</span>',
        description: 'Hard data points, benchmark metrics, client case histories, and verifiable credentials.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Block 11: <span class="font-medium">Objections & Friction Killers</span>',
        description: 'Preemptive responses to buyer hesitation, risk reversals, guarantees, and transition steps.',
        icon: 'tabler:help-hexagon',
      },
      {
        title: 'Block 12: <span class="font-medium">Strategic Call-to-Actions (CTAs)</span>',
        description: 'Standardized primary, secondary, and tertiary conversion triggers mapped by funnel stage.',
        icon: 'tabler:target-arrow',
      },
    ]}
  />

  <!-- Content Widget 2: How to Create a Brand DNA -->
  <Content
    tagline="Guided Synthesis"
    title="Construct Your Strategic Moat in Minutes"
    items={[
      {
        title: 'Interactive Ingestion',
        description: 'Answer guided prompts or import your existing landing pages, sales letters, and transcripts.',
        icon: 'tabler:file-import',
      },
      {
        title: 'Automated Synthesis',
        description: 'The engine parses your materials and distills them into 12 structured, verifiable strategy blocks.',
        icon: 'tabler:sparkles',
      },
    ]}
    image={{
      src: '/images/site/how-to-create-a-brand-dna.jpg',
      alt: 'How to Create a Brand DNA System',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-3">
        From Raw Content to Precision DNA
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed mb-4">
        You don't need a PhD in prompt engineering. Our guided setup extracts your authentic voice and core conversion arguments in a single sitting.
      </p>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed">
        Once created, your DNA lives as an active reference for every marketing project and team collaborator.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[var(--cm-secondary)]/30 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget 3: Avoid Generic Copywriting -->
  <Content
    isReversed
    tagline="Execution Engine"
    title="Brand Voice Consistency Across Every AI Execution"
    items={[
      {
        title: 'Automated Style Enforcement',
        description: 'Every generation automatically applies your vocabulary boundaries, cadence rules, and forbidden phrases.',
        icon: 'tabler:writing',
      },
      {
        title: 'Multi-Agent Cohesion',
        description: 'Whether writing VSLs, ads, or email follow-ups, your brand identity remains recognizably identical.',
        icon: 'tabler:affiliate',
      },
    ]}
    image={{
      src: '/images/site/how-to-avoid-generic-copywriting.jpg',
      alt: 'How to Avoid Generic Copywriting',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-3">
        One Brain. Unlimited Channels.
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed mb-4">
        Stop re-explaining who you are to separate AI chatbots. Build your DNA once and orchestrate an entire marketing department.
      </p>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed">
        The result is copy that builds compounding authority and drives sustainable direct response conversions.
      </p>
    </Fragment>
  </Content>

  <!-- Features2 Widget: Operational Flow -->
  <Features2
    tagline="Operational Flow"
    title="How Models Consume Your DNA"
    subtitle="Apply your Brand DNA as a consistent reference across team marketing workflows."
    columns={3}
    items={[
      {
        title: 'Workflow Reference',
        description: 'Reference your structured Brand DNA blocks as deterministic guidance across marketing workflows.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Specialized Multi-Agents',
        description: 'Copywriting, launch, and email agents automatically inherit versioned DNA parameters.',
        icon: 'tabler:robot',
      },
      {
        title: 'Continuous Evaluation Loop',
        description: 'Campaign results are analyzed to suggest targeted calibrations to specific blocks.',
        icon: 'tabler:refresh-dot',
      },
    ]}
  />

  <!-- CallToAction Widget -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      {
        text: 'Explore AI Agents',
        href: getPermalink('/agents'),
      },
    ]}
    title="Ready to Construct Your Brand DNA?"
    subtitle="Answer the guided 12-block workflow and generate persistent AI memory for your brand in minutes."
  />
</Layout>
