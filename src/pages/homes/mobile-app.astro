---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';

import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { headerData } from '~/navigation';

const appStoreImg = '~/assets/images/app-store.png';
const googlePlayImg = '~/assets/images/google-play.png';

const metadata = {
  title: 'CopyMonster Mobile — Brand DNA on the Go',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      {...headerData}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="Mobile Experience — Coming Soon"
    image={{
      src: 'https://images.unsplash.com/photo-1535303311164-664fc9ec6532?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'CopyMonster Mobile Experience',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">CopyMonster Mobile</span>: <br /> Your Brand DNA <span
        class="hidden xl:inline">in your pocket</span
      >
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Access your strategic brand identity and deploy specialized AI agents from anywhere.
      </span>
      The world's first strategy-first Brand DNA operating system is arriving soon on App Store and Google Play.
    </Fragment>

    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href="https://app.copymonster.co">
        <Image src={appStoreImg} alt="App Store Coming Soon" width={200} format="webp" />
      </Button>

      <Button variant="link" href="https://app.copymonster.co">
        <Image src={googlePlayImg} alt="Google Play Coming Soon" width={200} format="webp" />
      </Button>
    </div>
  </Hero2>

  <!-- Features3 Widget ************** -->

  <Features3
    id="features"
    title="Why use the Mobile Monster?"
    subtitle="Built for the modern founder who needs to manage their brand identity without being chained to a desk. Your DNA never sleeps, and now your specialized agents are just a tap away for on-the-go campaigns."
    tagline="Monster Workflow"
    columns={2}
    items={[
      {
        title: 'DNA Strategy Sync',
        description: `Your 12 strategic blocks are fully synced. Update your positioning, voice, or audience on the fly.`,
        icon: 'tabler:dna',
      },
      {
        title: 'Mobile Agent Hub',
        description:
          'Deploy Hook, Headline, or Ads agents directly from your mobile dashboard using your unified strategic memory.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Performance Monitoring',
        description: 'Track Meta Ads and Instagram insights on the go. Refine your Brand DNA based on real-time ROAS.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Strategic Push Alerts',
        description: `Get notified when your DNA evolves or when key campaign metrics require human-in-the-loop attention.`,
        icon: 'tabler:bell',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521517407911-565264e7d82d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2069&q=80',
      alt: 'Mobile Strategy',
    }}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    title="Mobile Reach"
    stats={[
      { amount: '132', title: 'Countries' },
      { amount: '21K+', title: 'Community Members' },
      { amount: '12', title: 'DNA Blocks' },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Mobile FAQs"
    items={[
      {
        title: 'When is the mobile release?',
        description:
          'We are in private beta. Legend and Enterprise members will receive early access before the public launch in Q1 2027.',
      },
      {
        title: 'Can I map my DNA on mobile?',
        description:
          'Yes. The mobile app allows full editing of your 12-block Brand DNA, including both structural and adaptive layers.',
      },
      {
        title: 'Does it support self-hosting?',
        description: `Yes. MIT Open Core users can connect their own self-hosted CopyMonster instances to the mobile app interface.`,
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    id="download"
    title="Join the Mobile Waitlist"
    subtitle="Be the first to know when the Monster hits the stores. Protect your Brand DNA from anywhere."
    actions={[
      {
        variant: 'primary',
        text: 'Join Waitlist',
        href: 'https://app.copymonster.co',
      },
    ]}
  />
</Layout>
