---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { headerData } from '~/navigation';

const metadata = {
  title: 'Adriano Vieira — Founder of CopyMonster',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      {...headerData}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="Adriano Vieira"
    tagline="Founder & Strategist"
    actions={[{ variant: 'primary', text: 'Connect on Instagram', href: 'https://www.instagram.com/eusouadrianovieira', target: '_blank' }]}
  >
    <Fragment slot="subtitle">
      Adriano is a father of 7, a proud grandfather of 3, and a bulletproof coffee enthusiast — the daily fuel for his strategic vision and relentless execution. <br /> 
      A Sales Funnel Reverse Engineer, Digital Strategist, and AI Solutions Architect, he serves as the CEO of Integridade Digital Marketing, with 11+ years leading the digital landscape.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-instagram',
        callToAction: {
          target: '_blank',
          text: 'Instagram',
          href: 'https://www.instagram.com/eusouadrianovieira',
        },
      },
      {
        icon: 'tabler:brand-linkedin',
        callToAction: {
          target: '_blank',
          text: 'LinkedIn',
          href: 'https://www.linkedin.com/in/adriano-integridade-digital/',
        },
      },
      {
        icon: 'tabler:brand-github',
        callToAction: {
          target: '_blank',
          text: 'GitHub',
          href: 'https://github.com/Adriano-Digital2024/CopyMonster',
        },
      },
    ]}
    image={{
      src: 'https://integridadedigital.com.br/lovable-uploads/2ee743a1-ef79-4d7c-8a58-a2437fe1e1af.png',
      alt: 'Adriano Vieira — Strategic Authority',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">A Battlefield-Tested Authority</h2>
      <p>
        Adriano Vieira didn't start as an "expert." His authority was forged in the trenches of digital marketing, where he mastered the reverse engineering of high-performance sales funnels and the validation of complex digital assets.
      </p>
      <br />
      <p>
        As the founder of CopyMonster.me and the visionary behind the 1st National Online Drone Congress, Adriano builds digital solutions that bridge the gap between cutting-edge technology and real-world conversion.
      </p>
      <br />
      <p>Follow his strategic journey:</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="Core Milestones"
    items={[
      {
        title:
          'CEO & Founder <br /> <span class="font-normal">Integridade Digital Marketing</span> <br /> <span class="text-sm font-normal">2013 - Present</span>',
        description: `Helping thousands of entrepreneurs transform knowledge and talents into scalable businesses. <br /> Creator of the "Plano & Ação" consultancy.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Community Leader <br /> <span class="font-normal">"How to Create an Extraordinary Digital Product"</span> <br /> <span class="text-sm font-normal">21,600+ Members</span>',
        description: `Founding member of "Multiplicadores de Talentos," where strategy, positioning, and funnels are applied in practice.`,
        icon: 'tabler:users',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Strategic Expertise"
    subtitle="Built on the intersection of LLM engineering, copy strategy, and real-world conversion."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Funnel Reverse Engineering',
        description: 'Breaking down high-performance campaigns to their strategic DNA.',
      },
      {
        title: 'LLM AI Solutions',
        description: 'Architecting strategic memory layers for the agentic era.',
      },
      {
        title: 'Strategic Copywriting',
        description: 'Writing that converts because it is built on identity, not prompts.',
      },
      {
        title: 'Community Scaling',
        description: 'Building and managing active communities with 20K+ members.',
      },
      {
        title: 'Product Validation',
        description: 'Rapidly moving from raw ideas to market-ready digital assets.',
      },
      {
        title: 'Digital Authority',
        description: 'Transforming audience into predictable and sustainable revenue.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Let's build your Extraordinary Product"
    subtitle="Ready to stop depending on algorithms and start building real assets?"
    actions={[
      {
        variant: 'primary',
        text: 'Join the Community',
        href: 'https://www.facebook.com/groups/planoeacao',
        target: '_blank',
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Strategic Insights"
    information={`Read my articles on sales funnels, AI integration, and the future of strategic marketing.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
