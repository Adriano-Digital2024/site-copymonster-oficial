---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'CopyMonster for SaaS — Brand Intelligence',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      {...headerData}
      actions={[
        {
          variant: 'primary',
          text: 'Free Trial',
          href: 'https://app.copymonster.co',
        },
      ]}
      isSticky
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="SaaS Intelligence"
    actions={[
      { variant: 'primary', target: '_blank', text: 'Launch DNA Engine', href: 'https://app.copymonster.co' },
      { text: 'Learn more', href: '#features' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1580481072645-022f9a6dbf27?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'CopyMonster SaaS Interface',
    }}
  >
    <Fragment slot="title">
      The first <span class="text-accent dark:text-white">Brand DNA</span> SaaS: <br /> identity that scales with AI
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Transform your business vision into a permanent AI memory with <span class="font-semibold">CopyMonster</span>.</span
      >
      Stop training prompts. Start polishing your Brand DNA to power specialized agents that work 24/7.
    </Fragment>
  </Hero2>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="Why choose CopyMonster SaaS?"
    subtitle="Our infrastructure is built for founders who value identity over generic automation."
    columns={2}
    items={[
      {
        title: 'Unified Brand Brain',
        description:
          'Your DNA feeds every agent. No more disconnected responses or off-brand content across your multi-agent team.',
        icon: 'tabler:dna',
      },
      {
        title: 'Scalable for Teams & Agencies',
        description: `Manage multiple Brand DNAs and hundreds of agents from a single workspace with enterprise-grade security.`,
        icon: 'tabler:users-group',
      },
      {
        title: 'Performance-Driven Evolution',
        description:
          'Integrate with Meta and Instagram Insights to let real-world performance data refine your Brand DNA automatically.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'Agentic Infrastructure',
        description: `Not just a writer, but the system where your brand's communication is born, optimized, and deployed.`,
        icon: 'tabler:network',
      },
      {
        title: 'MIT Open Core Foundation',
        description: `Built on transparency. Trust our open-source core while scaling with our high-performance SaaS managed layers.`,
        icon: 'tabler:brand-github',
      },
      {
        title: 'Strategic Market Radar',
        description: `AI-driven scanning for opportunities that reinforce your brand's unique positioning against competitors.`,
        icon: 'tabler:radar',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    title="SaaS Intelligence Use Cases"
    subtitle="See how CopyMonster transforms generic automation into strategic intelligence for modern software teams."
    isReversed
    items={[
      {
        title: 'Identity-First Scaling:',
        description:
          'Are you a startup with a unique voice? Protect it. CopyMonster ensures your personality is preserved as you scale from one to one hundred agents. Our 12-block strategic map is your brand\'s insurance in the AI era.',
      },
      {
        title: 'Strategic Benefits:',
        description: `Ensure cohesive messaging across multi-agent deployments. <br /> Effectively communicate complex features via DNA-trained logic. <br /> Prioritize user pain points through structured strategic memory. <br /> Encourage high-intent actions with integrated CTAs.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1620558138198-cfb9b4f3c294?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1671&q=80',
      alt: 'SaaS Precision',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Scaling Brand Intelligence: <br /><span class="text-2xl">Precision at Scale</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent={true}
    items={[
      {
        title: 'Unified Customer Experience:',
        description: `For SaaS businesses, user experience is everything. CopyMonster enhances every touchpoint by ensuring your agents speak with your specific authority. Our 12-block DNA integration guarantees a strategic consistency that generic AI tools simply cannot match.`,
      },
      {
        title: 'Performance Benefits:',
        description: `Cohesive and user-centric strategic narratives. <br /> Communicate complex SaaS features through DNA-trained logic. <br /> Map your Voice, Offer, and Mechanism before generating a single line. <br /> Drive higher-converting leads through strategy-first copy.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1531973486364-5fa64260d75b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1658&q=80',
      alt: 'User Experience',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        SaaS Excellence: <br /><span class="text-2xl">Strategy Before Generation</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Pricing Widget ******************* -->

  <Pricing
    title="Monster SaaS Plans"
    prices={[
      {
        title: 'Starter Cloud',
        subtitle: 'For freelance copywriters',
        price: 47,
        period: '/ Month',
        callToAction: {
          target: '_blank',
          text: 'Free Trial',
          href: 'https://app.copymonster.co',
        },
      },
      {
        title: 'Pro Cloud',
        subtitle: 'Small agencies & SaaS teams',
        price: 97,
        period: '/ Month',
        callToAction: {
          target: '_blank',
          text: 'Get Pro',
          href: 'https://app.copymonster.co',
        },
        hasRibbon: true,
        ribbonTitle: 'popular',
      },
      {
        title: 'Enterprise Cloud',
        subtitle: 'Holdings & In-house Teams',
        price: '1,500+',
        period: '/ Month',
        callToAction: {
          target: '_blank',
          text: 'Contact Sales',
          href: 'https://app.copymonster.co',
        },
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="SaaS FAQs"
    items={[
      {
        title: 'Why mandatory DNA mapping?',
        description:
          'Because generic prompts lead to generic copy. By forcing a 12-block strategy map first, we ensure your AI agents have the permanent memory needed to sound like your brand.',
        icon: 'tabler:chevrons-right',
      },
      {
        title: 'What LLMs do you support?',
        description:
          'CopyMonster is BYO LLM. You can configure OpenAI, Anthropic, Google, Mistral, OpenRouter, or even a local Ollama server for maximum privacy.',
        icon: 'tabler:chevrons-right',
      },
      {
        title: 'How does the performance loop work?',
        description:
          'In Enterprise, our engine automatically evolves your Brand DNA based on real Meta Ads and Instagram insights (ROAS, CTR, hooks).',
        icon: 'tabler:chevrons-right',
      },
      {
        title: 'Is the core engine open source?',
        description: `Yes, we are MIT licensed. You can self-host the core DNA engine, fork it, and audit every strategic prompt.`,
        icon: 'tabler:chevrons-right',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Contact Strategic Support"
    subtitle="Have questions about DNA mapping or Multi-agent scaling?"
    callToAction={{
      text: 'Connect Now',
      href: '/contact',
    }}
    items={[
      {
        title: 'Email us',
        description: 'contato@copymonster.co',
        icon: 'tabler:mail',
      },
      {
        title: 'Open Source',
        description: 'Join the development on GitHub',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Follow the Vision',
        description: '@eusouadrianovieira',
        icon: 'tabler:brand-instagram',
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Monster Blog"
    information={`Explore strategic insights on Brand DNA, Multi-agent AI, and the future of digital marketing.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
