---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Brands from '~/components/widgets/Brands.astro';

import { YouTube } from 'astro-embed';

const metadata = {
  title: 'CopyMonster for Startups — Strategic DNA',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Startup DNA"
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Deploy Identity',
        href: 'https://app.copymonster.me',
        icon: 'tabler:rocket',
      },
      { text: 'Learn more', href: '#features' },
    ]}
  >
    <Fragment slot="title">
      Protect your <span class="text-accent dark:text-white">Startup DNA</span> from the generic AI wave
    </Fragment>

    <Fragment slot="subtitle">
      Stop wasting cycles on prompt engineering. <span class="font-semibold">CopyMonster</span> provides the infrastructure to build, version, and scale your brand identity as a unified AI memory.
    </Fragment>

    <Fragment slot="image">
      <YouTube id="gxBkghlglTg" title="The Future of Brand Intelligence" />
      <style is:inline>
        lite-youtube {
          margin: 0 auto;
          max-width: 100%;
        }
      </style>
    </Fragment>
  </Hero>

  <!-- Features2 Widget ************** -->

  <Features2
    title="The Differentiator: Strategy Over Automation"
    subtitle="In a world where execution is a commodity, your unique Brand DNA is your only sustainable moat. Founded by Adriano Vieira, CopyMonster is the only platform that forces you to map 12 strategic blocks before writing a single word. We don't just generate text; we architect brand authority using a multi-agent system that reads from your permanent strategic memory."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Stats Widget ****************** -->

  <Stats
    title="The Monster Impact"
    subtitle="Trusted by visionaries who value brand integrity over generic AI noise."
    stats={[
      { title: 'Global Presence', amount: '132' },
      { title: 'Brand DNAs Built', amount: 'Multi-Tenant' },
      { title: 'Strategic Community', amount: '21K+' },
      { title: 'DNA Blocks', amount: '12' },
    ]}
  />

  <!-- Brands Widget ****************** -->

  <Brands
    title="Powered by Intelligence"
    subtitle="CopyMonster is BYO LLM. Integrate with OpenAI, Anthropic, Mistral, or self-host via Ollama to power your strategic DNA."
    icons={[]}
    images={[
      {
        src: 'https://cdn.pixabay.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1280&q=80',
        alt: 'AI Integration',
      },
      {
        src: 'https://cdn.pixabay.com/photo-1620558138198-cfb9b4f3c294?ixlib=rb-4.0.3&auto=format&fit=crop&w=1280&q=80',
        alt: 'Meta Ads',
      },
      {
        src: 'https://cdn.pixabay.com/photo-1531973486364-5fa64260d75b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1280&q=80',
        alt: 'Global Scale',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="What services do we provide?"
    subtitle="We provide the infrastructure for startups to dominate their market through identity and strategic memory."
    items={[
      {
        title: 'DNA Strategy Mapping',
        description:
          'Guided onboarding across 12 structured blocks (Voice, Audience, Offer, Mechanism, etc.) before unlocking any agent.',
        icon: 'tabler:dna',
      },
      {
        title: 'Multi-Agent Orchestration',
        description:
          'Specialist agents for Hooks, Headlines, VSLs, and Ads that all pull from your unified, versioned Brand DNA.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Performance Feedback Loop',
        description:
          'Integrate Meta Ads and Instagram to feed real performance metrics back into your adaptive DNA layer.',
        icon: 'tabler:refresh',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="Main features of our template"
    subtitle="Engineered for high-growth startups that need to maintain a world-class voice while scaling with AI."
    columns={3}
    items={[
      {
        title: '12-Block Brand DNA',
        description:
          'Mandatory strategic map: 6 structural blocks and 6 adaptive blocks to define your unique brand identity.',
        icon: 'tabler:check',
      },
      {
        title: 'Meta Ads Intelligence',
        description: 'Automatic DNA evolution based on real-world ROAS, CTR, and hook retention metrics.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'DNA Versioning',
        description:
          'Version your brand strategy like code. Compare and revert to past high-performing identities.',
        icon: 'tabler:history',
      },
      {
        title: 'Multilingual Native',
        description: 'PT, EN, and ES out of the box, with strategic nuance preserved across cultures.',
        icon: 'tabler:world',
      },
      {
        title: 'BYO LLM Security',
        description:
          'Lovable Gateway, OpenAI, Anthropic, or local Ollama. You own your intelligence providers.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'MIT Open Source',
        description: 'Self-host, fork, and audit every prompt. Full transparency in the age of black-box AI.',
        icon: 'tabler:brand-github',
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    items={[
      {
        title: 'Why "No DNA → No Copy"?',
        description:
          'Generic prompts create generic copy. We force strategy first so that every line of generated text sounds like your brand.',
      },
      {
        title: 'Can I self-host CopyMonster?',
        description:
          'Yes. The Core engine is MIT licensed. You can deploy it on your own servers for total data sovereignty.',
      },
      {
        title: 'How does the performance engine work?',
        description:
          'In Enterprise, we evolve your DNA adaptive layer (Angles, Hooks, CTAs) based on real Meta performance.',
      },
      {
        title: 'Who is Adriano Vieira?',
        description:
          'A Sales Funnel Reverse Engineer and Strategist who built CopyMonster to solve the "generic AI" problem for agencies.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Get CopyMonster',
        href: 'https://github.com/Adriano-Digital2024/CopyMonster',
        icon: 'tabler:brand-github',
      },
    ]}
  >
    <Fragment slot="title">Be a part of our vision</Fragment>

    <Fragment slot="subtitle">
      Discover the first open-source AI platform that prioritizes Brand DNA. Join the 2% of professionals who dominate with strategy.
    </Fragment>
  </CallToAction>
</Layout>
