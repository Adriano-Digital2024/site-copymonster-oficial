---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'CopyMonster — Brand DNA Operating System for AI',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero Widget ******************* -->
  <Hero
    id="hero"
    tagline="The Brand DNA Operating System"
    actions={[
      {
        variant: 'primary',
        text: 'Deploy Brand OS — Start 7-Day Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:cpu',
      },
      { text: 'See How It Works', href: '#dna-engine' },
    ]}
  >
    <Fragment slot="title">
      <span class="hero-animate-title inline-block text-white">
        Your Brand Has a DNA. <span class="text-blue-400">CopyMonster</span> Is the System That Keeps It Alive.
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hero-animate-subtitle inline-block text-slate-200 dark:text-slate-300">
        Define your brand once. Then launch funnels, pages, automations, ads, emails, and entire campaigns — all powered
        by the same versioned strategic memory. No prompt drift. No generic AI. No rebuilding your voice from scratch
        every time you open a chat.
      </span>
    </Fragment>

    <Fragment slot="content">
      <p class="hero-animate-content mt-4 text-sm text-slate-300 dark:text-slate-400">
        No credit card required · 100 free credits · Open Core (MIT)
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div
        class="hero-bg-parallax absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('/images/home/01-hero.jpg');"
      >
      </div>
      <div class="absolute inset-0 bg-slate-950/80 dark:bg-slate-950/85 backdrop-blur-[2px]"></div>
    </Fragment>
  </Hero>

  <!-- Hero Visual Caption / Note ******************* -->
  <div class="intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade">
    <Note title="The Rule:" description="No DNA. No Copy." />
  </div>

  <!-- 2. The Problem Widget **************** -->
  <Content
    id="problem"
    isReversed
    tagline="The Problem"
    title="Generic AI Is Killing Your Brand Essence"
    items={[
      {
        title: 'Strategy First, Copy Later',
        description:
          'Intelligence without identity is just noise. Gain a structural competitive advantage by defining your DNA before you write a single line.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Prompt vs. Memory',
        description:
          'Stop relying on temporary prompts and fragile chat sessions. Build a permanent strategic memory that grows with your business.',
        icon: 'tabler:database',
      },
      {
        title: 'Unified Identity',
        description:
          'Ensure every agent — from copywriting to sales sequences — communicates with the exact same voice, authority, and values.',
        icon: 'tabler:shield-check',
      },
    ]}
    image={{
      src: '/images/home/02-problem.jpg',
      alt: 'Generic AI Is Killing Your Brand Essence',
    }}
  >
    <Fragment slot="content">
      <p class="text-muted dark:text-slate-300 mb-4">
        AI democratized content creation. It also democratized generic output. Every expert, infoproductor, and mentor
        now has access to the same models, the same prompts, and the same vocabulary — which means every brand sounds
        identical to the next.
      </p>
      <p class="text-muted dark:text-slate-300 mb-4">
        The result is a paradox: the more you produce, the less you sound like yourself.
      </p>
      <p class="text-muted dark:text-slate-300 font-semibold mb-6">
        CopyMonster was built to close that gap. Not with better prompts. With structural memory.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 3. Brand DNA Engine Widget *************** -->
  <Features
    id="dna-engine"
    tagline="Core Infrastructure"
    title="One DNA. Every Agent. Zero Drift."
    columns={2}
    items={[
      {
        title: '12-Block Strategic Map',
        description:
          'Map your history, values, positioning, ICP pain points, and offer architecture through an oriented 12-block framework.',
        icon: 'tabler:dna',
        callToAction: {
          text: 'Explore the DNA Engine',
          href: getPermalink('/dna'),
        },
      },
      {
        title: 'Immutable Versioning',
        description:
          'Track DNA evolution across v1, v2, and v3 releases. Never worry about accidental prompt drift or overwritten intelligence.',
        icon: 'tabler:git-branch',
      },
      {
        title: 'Opt-In Injection',
        description:
          'Choose which DNA powers each session. The structured POSITIONING CONTEXT block is injected into the runtime automatically — or choose "No DNA" when you want a clean slate.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Multi-DNA Management',
        description:
          'Manage multiple brand profiles in Settings → My DNA. Create, resume, duplicate, set as default, archive, and refine — ideal for agencies and multi-product creators.',
        icon: 'tabler:folders',
      },
    ]}
  >
    <Fragment slot="subtitle">
      <span>
        The Brand DNA Engine is the foundation of everything CopyMonster does. Through a guided 12-block strategic
        interview, the system maps your promise, persona, pain points, unique mechanisms, tone of voice, objections, and
        offer architecture into a structured, versioned document. That document becomes permanent memory. Every agent
        you deploy — copy, funnel, email, ads, automation — reads from the same source. You never rewrite your brand
        context again.
      </span>
      <div
        class="section-image-wrapper mt-8 mb-4 overflow-hidden rounded-xl intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        <img
          src="/images/home/03-dna-engine.jpg"
          alt="Brand DNA Engine"
          class="section-image w-full max-w-4xl mx-auto rounded-xl shadow-lg border border-slate-200 dark:border-slate-800"
          loading="lazy"
        />
      </div>
    </Fragment>
  </Features>

  <!-- 4. Agent Orchestration Widget *************** -->
  <Features
    id="agents"
    tagline="Multi-Agent Architecture"
    title="Deploy Specialized Agents That Share the Same Brain."
    columns={2}
    items={[
      {
        title: 'Copywriting Agents',
        description:
          'Presets for VSL scripts, paid ads, email sequences, landing pages, and sales copy — each calibrated to your DNA and to proven direct-response frameworks.',
        icon: 'tabler:file-text',
        callToAction: {
          text: 'View AI Agents',
          href: getPermalink('/agents'),
        },
      },
      {
        title: 'Funnel & Launch Agents',
        description:
          'Build the entire funnel from a single brief: opt-in, sales page, order bump, upsell, thank-you. Every page ships with the same voice.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Research & Market Agents',
        description:
          'Web search, page scraping, and competitive analysis — feeding insights back into your versioned DNA.',
        icon: 'tabler:world-search',
      },
      {
        title: 'Planning & Delegation',
        description:
          'Planning mode, goal management, task lists, subagent delegation, and background execution. The system structures complex work before it runs.',
        icon: 'tabler:list-check',
      },
    ]}
  >
    <Fragment slot="subtitle">
      <span>
        CopyMonster is not a single chatbot. It is an orchestration layer where every capability is an agent — and every
        agent reads from the same Brand DNA. The agent that writes your VSL, the agent that builds your funnel, the
        agent that sequences your emails, the agent that analyzes your market — they all operate from one strategic
        memory. Consistency is structural, not manual.
      </span>
      <div
        class="section-image-wrapper mt-8 mb-4 overflow-hidden rounded-xl intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        <img
          src="/images/home/04-agent-orchestration.jpg"
          alt="Agent Orchestration"
          class="section-image w-full max-w-4xl mx-auto rounded-xl shadow-lg border border-slate-200 dark:border-slate-800"
          loading="lazy"
        />
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- 5. The Complete Launch App Widget *************** -->
  <Features
    id="launch-app"
    tagline="Complete Launch Infrastructure"
    title="The Complete Launch App."
    columns={3}
    items={[
      {
        title: 'Complete Funnels',
        description:
          'Build the entire funnel — opt-in, sales page, order bump, upsell, thank-you — from one DNA. Every page ships with the same voice, no prompt rewriting between steps.',
        icon: 'tabler:git-merge',
      },
      {
        title: 'Any Integration',
        description:
          'Connect your funnel to the tools your business already uses — payment, email, CRM, WhatsApp, analytics. The launch runs end-to-end without manual stitching.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Payment-Ready Pages',
        description:
          'Pages come ready to receive payments. Checkout, order bumps, and upsells configured without touching code. From ad click to confirmed sale, one flow.',
        icon: 'tabler:credit-card',
      },
      {
        title: 'Automations in a Few Clicks',
        description:
          'Pre-built automations for the moments that matter — cart abandonment, post-purchase, re-engagement, launch sequences. Activate in a few clicks, not a few weeks.',
        icon: 'tabler:bolt',
      },
      {
        title: 'The Launch App',
        description:
          'CopyMonster is the complete launch app. From first ad to final follow-up, every asset, page, and automation ships from one strategic memory.',
        icon: 'tabler:rocket',
        callToAction: {
          text: 'Explore Launch Infrastructure',
          href: getPermalink('/launch'),
        },
      },
    ]}
  >
    <Fragment slot="subtitle">
      <span>
        CopyMonster is not just where you write copy. It is where you launch. From the first ad to the final follow-up,
        every asset, page, and automation ships from one strategic memory. Launch once. Launch again. Evolve each time.
      </span>
      <div
        class="section-image-wrapper mt-8 mb-4 overflow-hidden rounded-xl intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        <img
          src="/images/home/05-launch-app.jpg"
          alt="The Complete Launch App"
          class="section-image w-full max-w-4xl mx-auto rounded-xl shadow-lg border border-slate-200 dark:border-slate-800"
          loading="lazy"
        />
      </div>
    </Fragment>
  </Features>

  <!-- 6. Connected Workflows & MCP Widget *************** -->
  <Features
    id="integrations"
    tagline="Connected Workflows"
    title="Your Brand DNA, Inside the Tools You Already Use."
    columns={2}
    items={[
      {
        title: 'MCP Connectors',
        description:
          'Connect Supabase, WhatsApp, Stripe, Notion, GitHub, Google Drive, and any service with an MCP server.',
        icon: 'tabler:plug',
        callToAction: {
          text: 'Explore Integrations',
          href: getPermalink('/integrations'),
        },
      },
      {
        title: 'Workspace Context',
        description: 'The agent works inside a selected workspace — files, tasks, and context tied to that area.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'File & Shell Tools',
        description:
          'Read, create, edit, and search files. Execute shell commands in a sandbox. Combine file changes with operational tasks.',
        icon: 'tabler:terminal-2',
      },
      {
        title: 'Approval & Permissions',
        description:
          'Every sensitive operation follows the active permission policy. The interface requests approval when the policy requires it — never unrestricted by default.',
        icon: 'tabler:lock-check',
      },
    ]}
  >
    <Fragment slot="subtitle">
      <span>
        CopyMonster speaks MCP (Model Context Protocol) — the open standard for connecting AI agents to external tools.
        That means your DNA can travel with you: into your CRM, your payment stack, your messaging, your analytics, your
        file system, your repositories. No vendor lock-in. No manual copy-paste between systems. Your strategic memory
        is portable, versioned, and sovereign.
      </span>
      <div
        class="section-image-wrapper mt-8 mb-4 overflow-hidden rounded-xl intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        <img
          src="/images/home/06-connected-workflows.jpg"
          alt="Connected Workflows and MCP"
          class="section-image w-full max-w-4xl mx-auto rounded-xl shadow-lg border border-slate-200 dark:border-slate-800"
          loading="lazy"
        />
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- 7. Strategic Performance Loop Widget **************** -->
  <Content
    id="performance-loop"
    tagline="The Feedback Loop"
    title="Launch. Measure. Evolve."
    items={[
      {
        title: 'Market Radar',
        description:
          'The system scans your market for new hooks, rising ideas, and opportunities — and notifies you when something is worth exploring.',
        icon: 'tabler:radar',
      },
      {
        title: 'Versioned Evolution',
        description:
          'Each new DNA version is proposed, reviewed, and approved by you. Nothing is overwritten. Nothing is lost.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Strategic Blueprint',
        description:
          'Three steps: Define your DNA. Apply it across assets. Scale and evolve with real conversion data.',
        icon: 'tabler:chart-arrows',
      },
    ]}
    image={{
      src: '/images/home/07-performance-loop.jpg',
      alt: 'Strategic Performance Loop',
    }}
    callToAction={{
      text: 'See the Performance Loop',
      href: getPermalink('/dna'),
    }}
  >
    <Fragment slot="content">
      <p class="text-muted dark:text-slate-300 mb-4">Most AI tools stop at generation. CopyMonster closes the loop.</p>
      <p class="text-muted dark:text-slate-300 mb-4">
        Campaign metrics feed back into your DNA. The system identifies what worked, what didn't, and what the market is
        signaling — then proposes a new DNA version.
      </p>
      <p class="text-muted dark:text-slate-300 font-semibold mb-6">
        Your v1 stays intact. Your v2 gets smarter. Your v3 compounds.
      </p>
    </Fragment>
  </Content>

  <!-- 8. Open Core (MIT) Widget *************** -->
  <Features
    id="open-core"
    tagline="Open Core"
    title="A Foundation You Can Inspect, Host, and Own."
    columns={2}
    items={[
      {
        title: 'MIT Licensed Core',
        description:
          'The core engine is MIT-licensed. Study it, self-host it, and maintain complete sovereignty over your strategic brand assets.',
        icon: 'tabler:license',
        callToAction: {
          text: 'View on GitHub',
          href: 'https://github.com/Adriano-Digital2024/site-copymonster-oficial',
          target: '_blank',
        },
      },
      {
        title: 'Provider Flexibility',
        description:
          'Configure your own models and credentials. Fallback between providers when the primary route fails.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Enterprise-Grade Scaling',
        description:
          'Multiple brand workspaces, role-based controls, and direct MCP streaming for high-throughput marketing teams.',
        icon: 'tabler:building-skyscraper',
      },
      {
        title: 'Multi-Tenant Security',
        description:
          'Row-level security, tenant isolation, disposable email blocking, and admin controls — built into the database layer.',
        icon: 'tabler:shield-lock',
      },
    ]}
  >
    <Fragment slot="subtitle">
      <span>
        CopyMonster is built on an Open Core architecture, MIT-licensed. The engine is transparent. You can study it,
        self-host it, and maintain complete sovereignty over your strategic brand assets. No black box. No vendor
        lock-in. No dependency on a single provider.
      </span>
      <div
        class="section-image-wrapper mt-8 mb-4 overflow-hidden rounded-xl intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        <img
          src="/images/home/08-open-core.jpg"
          alt="Open Core Architecture"
          class="section-image w-full max-w-4xl mx-auto rounded-xl shadow-lg border border-slate-200 dark:border-slate-800"
          loading="lazy"
        />
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- 9. Who It's For Widget *************** -->
  <Features
    id="who-its-for"
    tagline="Built For"
    title="For the Operators Who Refuse to Sound Generic."
    columns={2}
    items={[
      {
        title: 'Info-Product Creators',
        description:
          'Launch courses, mentorships, and communities without rebuilding your brand context for every asset.',
        icon: 'tabler:school',
      },
      {
        title: 'Experts & Mentors',
        description:
          'Build high-ticket positioning, sales pages, and follow-up sequences that sound like you — at scale.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Agencies',
        description: 'Manage multiple brand DNAs, workspaces, and launches from one operating system.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Content Operators',
        description: 'Run newsletters, social content, ads, and email flows from a single strategic memory.',
        icon: 'tabler:news',
        callToAction: {
          text: 'See Use Cases',
          href: getPermalink('/use-cases'),
        },
      },
    ]}
  >
    <Fragment slot="subtitle">
      <span> CopyMonster is built for the people who ship — not the ones who talk about shipping. </span>
      <div
        class="section-image-wrapper mt-8 mb-4 overflow-hidden rounded-xl intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        <img
          src="/images/home/09-who-its-for.jpg"
          alt="Built for Operators"
          class="section-image w-full max-w-4xl mx-auto rounded-xl shadow-lg border border-slate-200 dark:border-slate-800"
          loading="lazy"
        />
      </div>
    </Fragment>
  </Features>

  <!-- 10. Strategic Blueprint (Steps) Widget ****************** -->
  <Steps
    id="blueprint"
    tagline="Getting Started"
    title="Transform Your Brand in Three Steps."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Define Your DNA</span>',
        description:
          'Answer 12 strategic blocks to build your Brand DNA map. This establishes the permanent memory layer for all agents.',
        icon: 'tabler:dna',
      },
      {
        title: 'Step 2: <span class="font-medium">Apply Your Brand DNA</span>',
        description: 'Use your Brand DNA as a shared reference when creating and refining marketing assets.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Step 3: <span class="font-medium">Scale & Evolve</span>',
        description:
          'Run campaigns across ads, email, and organic channels. Feed real-world conversion metrics back into your versioned DNA.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Ready to Deploy!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '/images/home/10-strategic-blueprint.jpg',
      alt: 'Strategic Blueprint',
    }}
    callToAction={{
      text: 'Start 7-Day Free Trial',
      href: 'https://app.copymonster.co/',
      target: '_blank',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-transparent"></div>
    </Fragment>
  </Steps>

  <!-- 11. Proof & Stats Widget ****************** -->
  <Content
    id="stats"
    isReversed={false}
    tagline="By the Numbers"
    title="By the Numbers"
    subtitle="Built for Scale. Designed for Identity."
  >
    <Fragment slot="content">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2">
        <div
          class="stat-card p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 shadow-md transition-all duration-300 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
        >
          <div class="font-heading text-primary dark:text-blue-400 text-3xl sm:text-4xl font-bold">30</div>
          <div class="text-sm font-medium uppercase tracking-wider text-slate-700 dark:text-slate-300 mt-1">
            Countries in 1 Year
          </div>
        </div>
        <div
          class="stat-card p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 shadow-md transition-all duration-300 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
        >
          <div class="font-heading text-primary dark:text-blue-400 text-2xl sm:text-3xl font-bold">Open Source</div>
          <div class="text-sm font-medium uppercase tracking-wider text-slate-700 dark:text-slate-300 mt-1">
            MIT License
          </div>
        </div>
        <div
          class="stat-card p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 shadow-md transition-all duration-300 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
        >
          <div class="font-heading text-primary dark:text-blue-400 text-3xl sm:text-4xl font-bold">Multi</div>
          <div class="text-sm font-medium uppercase tracking-wider text-slate-700 dark:text-slate-300 mt-1">
            AI Agents
          </div>
        </div>
        <div
          class="stat-card p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 shadow-md transition-all duration-300 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
        >
          <div class="font-heading text-primary dark:text-blue-400 text-3xl sm:text-4xl font-bold">One</div>
          <div class="text-sm font-medium uppercase tracking-wider text-slate-700 dark:text-slate-300 mt-1">
            Brand DNA
          </div>
        </div>
        <div
          class="stat-card sm:col-span-2 p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 shadow-md transition-all duration-300 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
        >
          <div class="font-heading text-primary dark:text-blue-400 text-2xl sm:text-3xl font-bold">
            Active Workspaces
          </div>
          <div class="text-sm font-medium uppercase tracking-wider text-slate-700 dark:text-slate-300 mt-1">
            Used by Operators Worldwide
          </div>
        </div>
      </div>
    </Fragment>

    <Fragment slot="image">
      <div
        class="section-image-wrapper overflow-hidden rounded-xl intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        <img
          src="/images/home/11-proof-stats.jpg"
          alt="CopyMonster Worldwide Proof and Stats"
          class="section-image w-full rounded-xl shadow-xl border border-slate-200 dark:border-slate-800"
          loading="lazy"
        />
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 12. Final CallToAction Widget *********** -->
  <CallToAction
    id="final-cta"
    isDark={true}
    actions={[
      {
        variant: 'primary',
        text: 'Start 7-Day Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      {
        text: 'See How It Works',
        href: getPermalink('/dna'),
      },
    ]}
  >
    <Fragment slot="title">
      <span class="block text-white font-bold">Scale With Persistent Brand Memory.</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="block text-slate-100 font-medium">
        Deploy specialized agents trained on your 12-block Brand DNA. Stop prompt rewriting. Stop sounding generic.
        Start launching from one strategic memory.
      </span>
      <span class="block mt-4 text-base font-bold text-blue-300"> No DNA. No Copy. </span>
      <span class="block mt-2 text-xs text-slate-200">
        No credit card required · 100 free credits · Open Core (MIT)
      </span>
    </Fragment>

    <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('/images/home/12-final-cta.jpg');"
      >
      </div>
      <!-- Subtle gradient overlay: keeps image bright and clearly visible while ensuring contrast behind text -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-slate-950/20 dark:from-slate-950/50 dark:via-transparent dark:to-slate-950/30"
      >
      </div>
    </Fragment>
  </CallToAction>
</Layout>

<style is:global>
  /* ==========================================================================
     1. HERO PARALLAX & ENTRANCE ANIMATIONS
     ========================================================================== */
