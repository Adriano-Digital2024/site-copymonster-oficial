---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'CopyMonster — Brand DNA Operating System for AI',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Deploy Brand OS',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:cpu',
      },
      { text: 'See How It Works', href: getPermalink('/dna') },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'CopyMonster Hero Image' }}
  >
    <Fragment slot="title">
      The <span class="text-accent dark:text-white">Brand DNA</span> Operating System for AI
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Orchestrate specialized AI agents and marketing workflows from a single versioned brand foundation.
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">CopyMonster: Identity first.</span>
      Stop prompt drift. Build persistent strategic memory that powers every AI touchpoint.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="The Rule:" description="No DNA. No Copy." />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Platform Architecture"
    title="What you get with CopyMonster"
    subtitle="A complete infrastructure for strategic intelligence and brand identity in the AI era."
    items={[
      {
        title: 'Brand DNA Engine',
        description:
          'Transform your identity into permanent strategic memory. Our 12-block map ensures your AI never forgets who you are.',
        icon: 'tabler:dna',
        callToAction: {
          text: 'Explore DNA Engine',
          href: getPermalink('/dna'),
        },
      },
      {
        title: 'Multi-Agent Orchestration',
        description:
          'Deploy specialized agents that share the same brain. Consistency across copy, email, launches, and ads.',
        icon: 'tabler:users-group',
        callToAction: {
          text: 'View AI Agents',
          href: getPermalink('/agents'),
        },
      },
      {
        title: 'Connected Workflows',
        description:
          'Bring your Brand DNA into the workflows and tools your team already uses, as supported by your CopyMonster plan.',
        icon: 'tabler:plug-connected',
        callToAction: {
          text: 'Explore Integrations',
          href: getPermalink('/integrations'),
        },
      },
      {
        title: 'Open Core (MIT)',
        description:
          'A transparent, developer-friendly foundation. Build, inspect, and host your own agents with our open-source core.',
        icon: 'tabler:brand-github',
        callToAction: {
          text: 'GitHub Repository',
          href: 'https://github.com/Adriano-Digital2024/CopyMonster',
          target: '_blank',
        },
      },
      {
        title: 'Strategic Performance Loop',
        description:
          'Campaign metrics feed back into your DNA, allowing your brand intelligence to evolve with market feedback.',
        icon: 'tabler:refresh',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="The Problem"
    title="Generic AI is killing your brand essence"
    items={[
      {
        title: 'The AI Paradox',
        description:
          'AI democratized content creation, but also democratized generic output. Without a clear DNA, your brand sounds identical to competitors.',
      },
      {
        title: 'Prompt vs. Memory',
        description:
          'Stop relying on temporary prompts and fragile chat sessions. Build a permanent strategic memory that grows with your business.',
      },
      {
        title: 'Unified Identity',
        description:
          'Ensure every AI agent — from copywriting to sales sequences — communicates with the exact same voice, authority, and values.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Strategy Meeting',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Strategy first, Copy later</h3>
      Intelligence without identity is just noise. Gain a structural competitive advantage by defining your DNA first.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '12-Block Strategic Map',
        description:
          'Map your history, values, positioning, ICP pain points, and offer architecture through an oriented 12-block framework.',
      },
      {
        title: 'Immutable Versioning',
        description:
          'Track DNA evolution across v1, v2, and v3 releases. Never worry about accidental prompt drift or overwritten intelligence.',
      },
      {
        title: 'Open Core Transparency',
        description:
          'The core engine is MIT-licensed. Study it, self-host it, and maintain complete sovereignty over your strategic brand assets.',
      },
      {
        title: 'Enterprise-Grade Scaling',
        description:
          'Manage multiple brand workspaces, role-based controls, and direct MCP streaming for high-throughput marketing teams.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Strategic Blueprint',
    }}
  >
    <Fragment slot="content">Your brand identity is your greatest asset. Protect it with versioned memory.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Transform your brand with CopyMonster in 3 simple steps."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Define your DNA</span>',
        description:
          'Answer 12 strategic blocks to build your Brand DNA map. This establishes the permanent memory layer for all models.',
        icon: 'tabler:dna',
      },
      {
        title: 'Step 2: <span class="font-medium">Apply Your Brand DNA</span>',
        description:
          'Use your Brand DNA as a shared reference when creating and refining marketing assets.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Step 3: <span class="font-medium">Scale & Evolve</span>',
        description:
          'Run campaigns across ads, email, and organic channels. Feed real-world conversion metrics back into your versioned DNA.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Ready!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'CopyMonster Steps',
    }}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Countries', amount: '132' },
      { title: 'Community Members', amount: '21K+' },
      { title: 'Open Source', amount: 'MIT' },
      { title: 'AI Agents', amount: 'Multi' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start 7-Day Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      {
        text: 'See How It Works',
        href: getPermalink('/dna'),
      },
    ]}
  >
    <Fragment slot="title">
      Scale with Persistent Brand Memory
    </Fragment>

    <Fragment slot="subtitle">
      Deploy specialized agents trained on your 12-block Brand DNA. Stop prompt rewriting.<br class="hidden md:inline" />No DNA. No Copy.
    </Fragment>
  </CallToAction>
</Layout>
