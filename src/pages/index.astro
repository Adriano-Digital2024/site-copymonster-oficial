---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

  const metadata = {
  title: 'CopyMonster — Brand DNA Operating System for AI',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Start Branding',
        href: 'https://app.copymonster.me',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      { text: 'Learn more', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'CopyMonster Hero Image' }}
  >
    <Fragment slot="title">
      The first <span class="text-accent dark:text-white">Brand DNA</span> Operating System for AI
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        While the world uses AI to write generic text, <span class="font-semibold">CopyMonster</span> polishes, empowers, and positions your brand's essence before a single word is written.
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">CopyMonster: Identity first.</span>
      Stop generating generic content. Build an AI memory that thinks exactly like your brand.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="The Rule:" description="No DNA. No Copy." />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Features"
    title="What you get with CopyMonster"
    subtitle="A complete infrastructure for strategic intelligence and brand identity in the AI era."
    items={[
      {
        title: 'Brand DNA Engine',
        description:
          'Transform your identity into permanent strategic memory. Our 12-block map ensures your AI never forgets who you are.',
        icon: 'tabler:dna',
      },
      {
        title: 'Multi-Agent Orchestration',
        description:
          'Deploy dozens of specialized agents that share the same brain. Consistency across every channel, every time.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Strategic Performance Loop',
        description:
          'Campaign results feed back into your DNA, allowing your brand identity to evolve and improve automatically.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Open Core (MIT)',
        description:
          'A transparent, developer-friendly foundation. Build, modify, and host your own agents with our open-source core.',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Market Radar',
        description:
          "AI-driven scanning for market gaps and opportunities that reinforce your brand's unique essence.",
        icon: 'tabler:radar',
      },
      {
        title: 'Agentic Infrastructure',
        description:
          'Not just a tool, but the infrastructure where all communication for your business is born.',
        icon: 'tabler:network',
      },
    ]}
  />


  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="The Problem"
    title="Generic AI is killing your brand essence"
    items={[
      {
        title: 'The AI Paradox',
        description:
          'AI democratized content, but also democratized generic output. Without a clear DNA, your brand becomes invisible.',
      },
      {
        title: 'Prompt vs. Memory',
        description:
          "Stop relying on temporary prompts. Build a permanent strategic memory that grows with your business.",
      },
      {
        title: 'Unified Identity',
        description:
          'Ensure every AI agent — from sales to support — speaks with the exact same voice and authority.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Strategy Meeting',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Strategy first, Copy later</h3>
      Intelligence without identity is just noise. Gain a competitive advantage by defining your DNA first.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '12-Block Strategic Map',
        description: `Map your history, values, positioning, and value proposition through an oriented 12-question workflow.`,
      },
      {
        title: 'Intelligence-Based SaaS',
        description:
          'We don\'t sell an editor; we sell the intelligence engine that powers all your communication.',
      },
      {
        title: 'Open Core Transparency',
        description:
          "The core is MIT-licensed. Study it, host it, and trust that your brand data is secure and transparent.",
      },
      {
        title: 'Enterprise-Grade Scaling',
        description:
          'Advanced metrics, automatic DNA evolution, and multiple workspaces for large organizations and agencies.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Strategic Blueprint',
    }}
  >
    <Fragment slot="content">Your brand identity is your greatest asset. Protect it.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Transform your brand with CopyMonster in 3 simple steps."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Define your DNA</span>',
        description:
          "Answer 12 strategic questions to build your Brand DNA map. This becomes the permanent memory for your AI.",
        icon: 'tabler:dna',
      },
      {
        title: 'Step 2: <span class="font-medium">Deploy Agents</span>',
        description:
          "Connect specialized AI agents to your DNA. They will instantly understand your voice, promises, and value.",
        icon: 'tabler:users-group',
      },
      {
        title: 'Step 3: <span class="font-medium">Scale & Evolve</span>',
        description:
          'Launch campaigns and let the results feed back into your DNA, making your brand smarter every day.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Ready!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'CopyMonster Steps',
    }}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Countries', amount: '132' },
      { title: 'Community Members', amount: '21K+' },
      { title: 'Open Source', amount: 'MIT' },
      { title: 'AI Agents', amount: 'Multi' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Launch your DNA',
        href: 'https://app.copymonster.me',
        target: '_blank',
        icon: 'tabler:rocket',
      },
    ]}
  >
    <Fragment slot="title">
      Strategy&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Identity</span>
    </Fragment>

    <Fragment slot="subtitle">
      Stop producing generic content. Join the era of Brand Intelligence.<br class="hidden md:inline" />No DNA. No Copy.
    </Fragment>
  </CallToAction>

</Layout>
