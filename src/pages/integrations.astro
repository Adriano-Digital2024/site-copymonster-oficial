---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Integrations & Connectors — CopyMonster',
  description: 'Connect CopyMonster Brand DNA to GitHub, Claude Desktop, Cursor, Supabase, Notion, Stripe, and direct messaging channels.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget *************** -->

  <HeroText
    tagline="Ecosystem Connectivity"
    title="Integrate CopyMonster With Your Production Stack"
    subtitle="Embed your Brand DNA Operating System into your daily workflow, development environments, databases, and messaging channels."
    callToAction={{
      variant: 'primary',
      text: 'Start 7-Day Free Trial',
      href: 'https://app.copymonster.co/',
      target: '_blank',
      icon: 'tabler:puzzle',
    }}
    callToAction2={{
      text: 'See How It Works',
      href: getPermalink('/mcps'),
    }}
  />

  <!-- Features2 Widget (Connectors) ** -->

  <Features2
    tagline="Supported Connectors"
    title="Production-Ready Integrations"
    subtitle="Direct, authenticated data bridges designed for privacy, performance, and continuous synchronization."
    columns={3}
    items={[
      {
        title: 'Claude Desktop & Cursor',
        description: 'Native Model Context Protocol (MCP) support to query versioned Brand DNA in your favorite AI workspaces.',
        icon: 'tabler:terminal-2',
      },
      {
        title: 'GitHub & GitOps',
        description: 'Two-way sync and audit trails for your Brand DNA releases, ensuring complete developer governance.',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Supabase & Postgres',
        description: 'Connect enterprise data warehouses and vector stores directly to feed performance telemetry to your DNA.',
        icon: 'tabler:database',
      },
      {
        title: 'Notion & Docs',
        description: 'Bi-directional ingestion of brand guidelines, interview transcripts, and customer research notes.',
        icon: 'tabler:notebook',
      },
      {
        title: 'Stripe & Billing Webhooks',
        description: 'Trigger customer lifecycle and retention copy sequences based on real-time subscription events.',
        icon: 'tabler:credit-card',
      },
      {
        title: 'WhatsApp & Slack',
        description: 'Deploy copy generation and approval workflows straight into team channels and client chat threads.',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  />

  <!-- Content Widget (Security & Governance) -->

  <Content
    isReversed
    tagline="Enterprise Security"
    title="Data Sovereignty and Scoped Access"
    items={[
      {
        title: 'Role-Based Connector Permissions',
        description:
          'Control exactly which team members and external tools have read or write access to specific Brand DNA blocks.',
        icon: 'tabler:lock',
      },
      {
        title: 'Audit Logging & Revisions',
        description:
          'Every integration call, DNA parameter update, and agent invocation is recorded with immutable timestamps.',
        icon: 'tabler:file-text',
      },
      {
        title: 'Self-Hosted or Cloud',
        description:
          'Run integrations via CopyMonster Cloud or deploy the open-source MIT core on your own isolated infrastructure.',
        icon: 'tabler:server',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Enterprise Cloud Infrastructure',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Built for Scaled Marketing Teams</h3>
      Connect CopyMonster once, and keep your entire tech stack aligned around a single, immutable brand intelligence layer.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start 7-Day Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      {
        text: 'See How It Works',
        href: getPermalink('/mcps'),
      },
    ]}
  >
    <Fragment slot="title">
      Unify Your Brand Stack Today
    </Fragment>

    <Fragment slot="subtitle">
      Connect your tools and run AI agents with persistent, unified brand context.
    </Fragment>
  </CallToAction>
</Layout>
