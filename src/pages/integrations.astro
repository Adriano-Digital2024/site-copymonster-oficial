---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Integrations & Connectors — CopyMonster',
  description: 'A conceptual overview of how consistent brand context can support connected marketing workflows.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget *************** -->

  <HeroText
    tagline="Ecosystem Connectivity"
    title="Connect Brand Context to Your Workflows"
    subtitle="Explore how a shared Brand DNA can inform work across the tools and processes your team chooses to use."
    callToAction={{
      variant: 'primary',
      text: 'Start 7-Day Free Trial',
      href: 'https://app.copymonster.co/',
      target: '_blank',
      icon: 'tabler:puzzle',
    }}
    callToAction2={{
      text: 'See How It Works',
      href: getPermalink('/dna'),
    }}
  />

  <!-- Features2 Widget (Connectors) ** -->

  <Features2
    tagline="Connected Workflows"
    title="A Consistent Brand Context Across Your Work"
    subtitle="Conceptually, connected workflows can help teams apply the same brand foundation across different kinds of work."
    columns={3}
    items={[
      {
        title: 'Content Creation',
        description: 'Use a shared brand foundation as a reference when planning and creating marketing content.',
        icon: 'tabler:article',
      },
      {
        title: 'Campaign Planning',
        description: 'Keep positioning, audience context, and offer details in view as campaigns are planned.',
        icon: 'tabler:route',
      },
      {
        title: 'Team Collaboration',
        description: 'Give collaborators a common reference for discussing and reviewing brand-related work.',
        icon: 'tabler:users-group',
      },
    ]}
  />

  <!-- Content Widget (Security & Governance) -->

  <Content
    isReversed
    tagline="Shared Context"
    title="A Common Reference for Brand Decisions"
    items={[
      {
        title: 'Consistent Brand Context',
        description:
          'A clearly documented Brand DNA can help teams refer to the same positioning, audience, and offer information.',
        icon: 'tabler:lock',
      },
      {
        title: 'Purposeful Collaboration',
        description:
          'Teams can use their shared brand foundation to align discussions and creative reviews.',
        icon: 'tabler:file-text',
      },
      {
        title: 'Flexible Workflows',
        description:
          'Choose the tools and processes that fit your team; this page does not describe specific technical connectors.',
        icon: 'tabler:server',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Enterprise Cloud Infrastructure',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Start With a Shared Brand Foundation</h3>
      Brand DNA can serve as a consistent reference point when teams coordinate marketing work across their chosen tools.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start 7-Day Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      {
        text: 'See How It Works',
        href: getPermalink('/dna'),
      },
    ]}
  >
    <Fragment slot="title">
      Bring Your Brand Context Into the Work
    </Fragment>

    <Fragment slot="subtitle">
      Use your Brand DNA as a common reference across the workflows your team chooses to build.
    </Fragment>
  </CallToAction>
</Layout>
