---
import Layout from '~/layouts/LandingLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Lead Generation Landing Page Demo',
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero
    tagline="Monster Lead Generation"
    title="Stop Guessing. Start Scaling with Brand DNA."
    subtitle="Turn cold traffic into loyal brand advocates by building an AI memory that truly understands your value proposition."
    actions={[
      { variant: 'primary', text: 'Define your DNA', href: 'https://app.copymonster.me', icon: 'tabler:dna' },
      { text: 'Learn more', href: '#features' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1597423498219-04418210827d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'Magnetic Brand Identity',
    }}
  />

  <CallToAction
    title="Ready to dominate your niche?"
    subtitle="Join the elite 21K+ community members building extraordinary digital products."
    actions={[
      {
        variant: 'primary',
        text: 'Start Free Trial',
        href: 'https://app.copymonster.me',
        icon: 'tabler:rocket',
      },
    ]}
  />
</Layout>
