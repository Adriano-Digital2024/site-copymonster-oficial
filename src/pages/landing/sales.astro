---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Sales Landing Page Demo',
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="Legend Monster Access"
    title="The Long-form Strategy: Build a Brand that Outlasts the Algorithm"
    subtitle="In the era of AI, your narrative is your only moat. Discover how to build an unbreakable Brand DNA."
    actions={[
      { variant: 'primary', text: 'Become a Legend', href: 'https://app.copymonster.co', icon: 'tabler:award' },
      { text: 'See Pricing', href: '/pricing' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1621452773781-0f992fd1f5cb?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1626&q=80',
      alt: 'Strategic Narrative Showcase',
    }}
  />

  <CallToAction
    title="Scale without losing your soul"
    subtitle="Join the 132 countries already using CopyMonster to turn generic AI text into strategic Brand Intelligence."
    actions={[
      {
        variant: 'primary',
        text: 'Start Free Trial',
        href: 'https://app.copymonster.co',
        icon: 'tabler:rocket',
      },
    ]}
  />
</Layout>
