---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Subscription Landing Page Demo',
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="Monster Subscription"
    title="Keep your Brand Identity sharp with a Monster Subscription"
    subtitle="Unlock automatic Brand DNA evolution and priority agent access. Join the future of strategic intelligence."
    actions={[
      { variant: 'primary', text: 'Choose your Plan', href: '/pricing', icon: 'tabler:check' },
      { text: 'Start Free Trial', href: 'https://app.copymonster.co' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1593510987046-1f8fcfc512a0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Sustainable Growth Identity',
    }}
  />

  <CallToAction
    title="Your brand identity never sleeps"
    subtitle="Deploy agents, monitor results, and evolve your DNA 24/7."
    actions={[
      {
        variant: 'primary',
        text: 'Launch now',
        href: 'https://app.copymonster.co',
        icon: 'tabler:rocket',
      },
    ]}
  />
</Layout>
