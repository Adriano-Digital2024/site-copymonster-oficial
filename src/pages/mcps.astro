---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'MCP Directory — Model Context Protocol Servers — CopyMonster',
  description: 'Connect your versioned Brand DNA directly to Claude Desktop, Cursor, Zed, and agentic workflows via open MCP servers.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget *************** -->

  <HeroText
    tagline="Model Context Protocol"
    title="CopyMonster MCP Servers"
    subtitle="Direct, authenticated context pipelines from your Brand DNA into Claude Desktop, Cursor, Zed, and agentic frameworks. No prompt pasting required."
    callToAction={{
      variant: 'primary',
      text: 'Start 7-Day Free Trial',
      href: 'https://app.copymonster.co/',
      target: '_blank',
      icon: 'tabler:plug-connected',
    }}
    callToAction2={{
      text: 'See How It Works',
      href: getPermalink('/integrations'),
    }}
  />

  <!-- Content Widget (Architecture) * -->

  <Content
    isReversed
    tagline="Open Standard Protocol"
    title="Real-Time Brand Intelligence Inside Your Favorite Tools"
    items={[
      {
        title: 'Zero Copy-Pasting',
        description:
          'Stop pasting massive brand guidelines into chat windows. MCP allows your AI client to query Brand DNA blocks dynamically on demand.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Deterministic Scope',
        description:
          'Fetch only the specific DNA blocks required for the current task — ICP details for a sales page, tone guidelines for an email.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Version Locking',
        description:
          'Reference specific releases (`v1.2.0`) to ensure team-wide consistency across distributed engineering and marketing units.',
        icon: 'tabler:lock',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Model Context Protocol Network',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Native IDE & Agent Connectivity</h3>
      Model Context Protocol (MCP) is the open industry standard for AI connectivity. CopyMonster provides pre-built, production-tested MCP endpoints.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Features2 Widget (MCP Catalog) -->

  <Features2
    tagline="Curated Directory"
    title="Available MCP Servers"
    subtitle="Run locally via npx or connect directly to CopyMonster hosted cloud gateways."
    columns={3}
    items={[
      {
        title: 'Brand DNA Context Server',
        description: 'Command: npx -y @copymonster/mcp-dna. Streams full 12-block strategic memory and version snapshots.',
        icon: 'tabler:dna',
      },
      {
        title: 'Direct-Response Copy Server',
        description: 'Command: npx -y @copymonster/mcp-copy. Exposes specialized tools for headline scoring, sales letters, and angles.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Launch Funnel Server',
        description: 'Command: npx -y @copymonster/mcp-launch. Orchestrates multi-day event emails, CPL scripts, and webinar hooks.',
        icon: 'tabler:rocket',
      },
      {
        title: 'GEO Intelligence Server',
        description: 'Command: npx -y @copymonster/mcp-geo. Evaluates content density and entity mapping for AI answer engines.',
        icon: 'tabler:search',
      },
      {
        title: 'Voice & Tone Calibrator',
        description: 'Command: npx -y @copymonster/mcp-voice. Real-time linter validating vocabulary adherence and style constraints.',
        icon: 'tabler:volume',
      },
      {
        title: 'Performance Loop Server',
        description: 'Command: npx -y @copymonster/mcp-analytics. Pulls conversion telemetry to suggest strategic DNA parameter updates.',
        icon: 'tabler:chart-arrows',
      },
    ]}
  />

  <!-- Steps Widget (Configuration) ** -->

  <Steps
    tagline="Quickstart"
    title="Connect in 3 Simple Steps"
    subtitle="Add CopyMonster MCP to Claude Desktop or Cursor in under 60 seconds."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Generate API Key</span>',
        description: 'Access your CopyMonster workspace dashboard and copy your private connector key.',
        icon: 'tabler:key',
      },
      {
        title: 'Step 2: <span class="font-medium">Update Client Config</span>',
        description: 'Paste the CopyMonster server stanza into your claude_desktop_config.json or cursor settings file.',
        icon: 'tabler:code',
      },
      {
        title: 'Step 3: <span class="font-medium">Query Your Brand Live</span>',
        description: 'Use natural language tools inside your AI workspace to pull context, generate copy, and validate tone.',
        icon: 'tabler:check',
      },
      {
        title: 'Connected!',
        icon: 'tabler:plug-connected',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start 7-Day Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      {
        text: 'See How It Works',
        href: getPermalink('/integrations'),
      },
    ]}
  >
    <Fragment slot="title">
      Stream Brand Intelligence Into Your Tools
    </Fragment>

    <Fragment slot="subtitle">
      Eliminate context re-prompting forever with CopyMonster MCP servers.
    </Fragment>
  </CallToAction>
</Layout>
