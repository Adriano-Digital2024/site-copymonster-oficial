---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Plans & Pricing — CopyMonster',
  description: 'Scale your launch copywriting and autonomous AI funnels with dedicated multi-agent throughput.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget -->
  <HeroText
    tagline="Plans & Pricing"
    title="Scale Your Launch Copywriting & Autonomous AI Funnels"
    subtitle="Scale your launch copywriting and autonomous AI funnels with dedicated multi-agent throughput."
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 -mt-8 mb-16 not-prose">
    <!-- 1. Trial Banner -->
    <div
      class="mb-10 p-6 sm:p-8 rounded-2xl border border-[var(--cm-border)] bg-[var(--cm-card)] shadow-lg intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade"
    >
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🚀</span>
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-default dark:text-white flex flex-wrap items-center gap-2">
              7-Day Free Trial Active
              <span class="inline-block px-2.5 py-0.5 text-xs font-semibold rounded-full bg-[var(--cm-primary)]/15 text-[var(--cm-primary)] border border-[var(--cm-primary)]/30">
                Pro Access · 4 days remaining
              </span>
            </h2>
            <p class="text-sm text-default/80 dark:text-gray-300 mt-1 max-w-3xl">
              You have full access to our Pro plan features, including advanced multi-agent orchestration and up to 3 workspaces during your trial. Upon trial completion, your account transitions to the Starter tier.
            </p>
          </div>
        </div>
        <a
          href="https://app.copymonster.co/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-semibold bg-[var(--cm-primary)] text-white hover:opacity-90 transition-all shadow-md whitespace-nowrap"
        >
          Open App Workspace
          <Icon name="tabler:arrow-up-right" class="w-4 h-4 ml-1" />
        </a>
      </div>

      <!-- Token Consumption Bar -->
      <div class="pt-4 border-t border-[var(--cm-border)]/60">
        <div class="flex justify-between text-xs sm:text-sm font-medium mb-1.5 text-default/90 dark:text-gray-200">
          <span>Trial Token Consumption</span>
          <span class="font-bold text-[var(--cm-primary)]">819,716 / 1,000,000 tokens (82%)</span>
        </div>
        <div class="w-full h-2.5 bg-slate-200 dark:bg-slate-700/60 rounded-full overflow-hidden">
          <div
            class="h-full bg-[var(--cm-primary)] rounded-full transition-all duration-1000"
            style="width: 82%;"
          ></div>
        </div>
      </div>
    </div>

    <!-- 2. Billing Toggle -->
    <div class="flex flex-col items-center justify-center mb-12">
      <div class="inline-flex p-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-[var(--cm-border)] shadow-inner">
        <button
          type="button"
          id="btn-monthly"
          class="px-5 py-2.5 rounded-lg text-sm font-bold transition-all duration-200 bg-[var(--cm-primary)] text-white shadow cursor-pointer"
        >
          Monthly Billing
        </button>
        <button
          type="button"
          id="btn-annual"
          class="px-5 py-2.5 rounded-lg text-sm font-bold transition-all duration-200 text-default/80 dark:text-gray-300 hover:text-default cursor-pointer"
        >
          Annual Billing <span class="text-xs text-[var(--cm-primary)] font-extrabold ml-1">(Save up to 25%)</span>
        </button>
      </div>
      <p id="billing-note" class="text-xs text-default/70 dark:text-gray-400 mt-2.5 hidden">
        Annual billing grants upfront credits for continuous campaign automation.
      </p>
    </div>

    <!-- 3. Pricing Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      <!-- Card 1: Starter -->
      <div
        class="pricing-card flex flex-col justify-between p-7 sm:p-8 rounded-2xl bg-[var(--cm-card)] border border-[var(--cm-border)] shadow-md hover:border-[var(--cm-primary)] hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
      >
        <div>
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-default dark:text-white">Starter</h3>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-default/80">Solopreneur</span>
          </div>
          <p class="text-xs text-default/70 dark:text-gray-400 mb-6 min-h-[32px]">
            Essential direct response engine and brand DNA lock for solo operators.
          </p>

          <div class="mb-6 pb-6 border-b border-[var(--cm-border)]">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl sm:text-5xl font-black text-default dark:text-white">$<span class="plan-price" data-monthly="39" data-annual="29">39</span></span>
              <span class="text-sm text-default/70 dark:text-gray-400">/ month</span>
            </div>
            <p class="annual-subtext text-xs text-[var(--cm-primary)] font-medium mt-1.5 hidden" data-annual-note="Billed annually at $348/year (save $120/yr)">
              Billed annually at $348/year (save $120/yr)
            </p>
            <p class="text-sm font-semibold text-default/90 dark:text-gray-200 mt-4 flex items-center gap-2">
              <Icon name="tabler:dna" class="w-4 h-4 text-[var(--cm-primary)]" />
              Up to 3 Brand DNAs
            </p>
          </div>

          <ul class="space-y-3 text-sm text-default/85 dark:text-gray-300 mb-8">
            <li class="flex items-center gap-2.5">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>2,000,000 monthly tokens</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>1 Isolated Workspace</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>5 Concurrent Sessions</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>Automated email & social copy</span>
            </li>
          </ul>
        </div>

        <div class="space-y-3 pt-4 border-t border-[var(--cm-border)]/60">
          <a
            href="https://app.copymonster.co/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center py-3 px-4 rounded-xl font-bold text-sm bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 hover:opacity-90 transition-all shadow"
          >
            Subscribe to Starter
          </a>
          <button
            type="button"
            data-modal-target="modal-starter"
            class="open-spec-modal w-full text-center text-xs font-semibold text-[var(--cm-primary)] hover:underline py-1 flex items-center justify-center gap-1 cursor-pointer"
          >
            See full specifications
            <Icon name="tabler:chevron-right" class="w-3.5 h-3.5" />
          </button>
        </div>
      </div>

      <!-- Card 2: Pro (Most Popular) -->
      <div
        class="pricing-card relative flex flex-col justify-between p-7 sm:p-8 rounded-2xl bg-[var(--cm-card)] border-2 border-[var(--cm-primary)] shadow-xl transition-all duration-300 hover:-translate-y-1"
      >
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[var(--cm-primary)] text-white text-[11px] font-extrabold uppercase tracking-wider px-3.5 py-1 rounded-full shadow-md">
          Most Popular
        </div>

        <div>
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-default dark:text-white">Pro</h3>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-[var(--cm-primary)]/15 text-[var(--cm-primary)]">Agencies & Teams</span>
          </div>
          <p class="text-xs text-default/70 dark:text-gray-400 mb-6 min-h-[32px]">
            High-throughput autonomous funnel generation and multi-agent reasoning.
          </p>

          <div class="mb-6 pb-6 border-b border-[var(--cm-border)]">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl sm:text-5xl font-black text-default dark:text-white">$<span class="plan-price" data-monthly="99" data-annual="79">99</span></span>
              <span class="text-sm text-default/70 dark:text-gray-400">/ month</span>
            </div>
            <p class="annual-subtext text-xs text-[var(--cm-primary)] font-medium mt-1.5 hidden" data-annual-note="Billed annually at $948/year (save $240/yr)">
              Billed annually at $948/year (save $240/yr)
            </p>
            <p class="text-sm font-semibold text-default/90 dark:text-gray-200 mt-4 flex items-center gap-2">
              <Icon name="tabler:dna" class="w-4 h-4 text-[var(--cm-primary)]" />
              Up to 10 Brand DNAs
            </p>
          </div>

          <ul class="space-y-3 text-sm text-default/85 dark:text-gray-300 mb-8">
            <li class="flex items-center gap-2.5 font-medium">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>10,000,000 monthly tokens</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>5 Isolated Workspaces (RBAC)</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>20 Concurrent Sessions</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>High-converting VSL & Sales Pages</span>
            </li>
          </ul>
        </div>

        <div class="space-y-3 pt-4 border-t border-[var(--cm-border)]/60">
          <a
            href="https://app.copymonster.co/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center py-3 px-4 rounded-xl font-bold text-sm bg-[var(--cm-primary)] text-white hover:opacity-90 transition-all shadow-md"
          >
            Subscribe to Pro
          </a>
          <button
            type="button"
            data-modal-target="modal-pro"
            class="open-spec-modal w-full text-center text-xs font-semibold text-[var(--cm-primary)] hover:underline py-1 flex items-center justify-center gap-1 cursor-pointer"
          >
            See full specifications
            <Icon name="tabler:chevron-right" class="w-3.5 h-3.5" />
          </button>
        </div>
      </div>

      <!-- Card 3: Legend -->
      <div
        class="pricing-card flex flex-col justify-between p-7 sm:p-8 rounded-2xl bg-[var(--cm-card)] border border-[var(--cm-border)] shadow-md hover:border-[var(--cm-primary)] hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
      >
        <div>
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-default dark:text-white">Legend</h3>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-[var(--cm-primary)]/15 text-[var(--cm-primary)]">Scale & Enterprise</span>
          </div>
          <p class="text-xs text-default/70 dark:text-gray-400 mb-6 min-h-[32px]">
            Maximum dedicated multi-agent compute and unlimited brand portfolio scale.
          </p>

          <div class="mb-6 pb-6 border-b border-[var(--cm-border)]">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl sm:text-5xl font-black text-default dark:text-white">$<span class="plan-price" data-monthly="249" data-annual="199">249</span></span>
              <span class="text-sm text-default/70 dark:text-gray-400">/ month</span>
            </div>
            <p class="annual-subtext text-xs text-[var(--cm-primary)] font-medium mt-1.5 hidden" data-annual-note="Billed annually at $2388/year (save $600/yr)">
              Billed annually at $2388/year (save $600/yr)
            </p>
            <p class="text-sm font-semibold text-default/90 dark:text-gray-200 mt-4 flex items-center gap-2">
              <Icon name="tabler:dna" class="w-4 h-4 text-[var(--cm-primary)]" />
              Up to 50 Brand DNAs
            </p>
          </div>

          <ul class="space-y-3 text-sm text-default/85 dark:text-gray-300 mb-8">
            <li class="flex items-center gap-2.5 font-medium">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>35,000,000 monthly tokens</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>Unlimited Workspaces</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>Unlimited Concurrent Sessions</span>
            </li>
            <li class="flex items-center gap-2.5">
              <Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] flex-shrink-0" />
              <span>100 GB Dedicated Storage</span>
            </li>
          </ul>
        </div>

        <div class="space-y-3 pt-4 border-t border-[var(--cm-border)]/60">
          <a
            href="https://app.copymonster.co/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center py-3 px-4 rounded-xl font-bold text-sm bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 hover:opacity-90 transition-all shadow"
          >
            Subscribe to Legend
          </a>
          <button
            type="button"
            data-modal-target="modal-legend"
            class="open-spec-modal w-full text-center text-xs font-semibold text-[var(--cm-primary)] hover:underline py-1 flex items-center justify-center gap-1 cursor-pointer"
          >
            See full specifications
            <Icon name="tabler:chevron-right" class="w-3.5 h-3.5" />
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Specs Modals -->
  <!-- 1. Starter Modal -->
  <dialog id="modal-starter" class="spec-dialog backdrop:bg-black/60 rounded-2xl p-0 border border-[var(--cm-border)] bg-[var(--cm-card)] max-w-2xl w-[92vw] shadow-2xl text-default dark:text-white">
    <div class="p-6 sm:p-8">
      <div class="flex justify-between items-center pb-4 mb-4 border-b border-[var(--cm-border)]">
        <div>
          <h3 class="text-2xl font-bold">Starter Specifications</h3>
          <p class="text-xs text-default/70 dark:text-gray-400">Technical profile for solopreneurs and independent copywriters.</p>
        </div>
        <button type="button" class="close-modal p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-default/70 hover:text-default cursor-pointer">
          <Icon name="tabler:x" class="w-6 h-6" />
        </button>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-[var(--cm-border)] text-xs">
        <div><strong class="block text-default/60 dark:text-gray-400">Token Quota</strong> 2,000,000 tokens/month</div>
        <div><strong class="block text-default/60 dark:text-gray-400">Brand DNAs</strong> Up to 3 Brand DNAs</div>
        <div><strong class="block text-default/60 dark:text-gray-400">Workspaces</strong> 1 Isolated Workspace</div>
        <div><strong class="block text-default/60 dark:text-gray-400">Concurrency</strong> 5 Concurrent Sessions</div>
        <div><strong class="block text-default/60 dark:text-gray-400">Storage</strong> 1 GB Secure Storage</div>
        <div><strong class="block text-default/60 dark:text-gray-400">AI Architecture</strong> Standard AI Engine</div>
      </div>

      <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--cm-primary)] mb-3">Included:</h4>
      <ul class="space-y-2 text-sm text-default/85 dark:text-gray-300">
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> 2,000,000 monthly tokens (1.4M input / 600K output)</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> Up to 3 Brand DNAs</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> 1 isolated workspace with secure data isolation</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> Up to 5 concurrent agent execution sessions</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> Full campaign copy templates & funnel structures</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> Automated email & social copy pipelines</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> Community & email support</li>
      </ul>

      <div class="mt-8 pt-4 border-t border-[var(--cm-border)] flex justify-end gap-3">
        <button type="button" class="close-modal px-4 py-2 rounded-lg text-sm font-semibold border border-[var(--cm-border)] hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer">Close</button>
        <a href="https://app.copymonster.co/" target="_blank" class="px-5 py-2 rounded-lg text-sm font-bold bg-[var(--cm-primary)] text-white hover:opacity-90">Subscribe to Starter</a>
      </div>
    </div>
  </dialog>

  <!-- 2. Pro Modal -->
  <dialog id="modal-pro" class="spec-dialog backdrop:bg-black/60 rounded-2xl p-0 border border-[var(--cm-border)] bg-[var(--cm-card)] max-w-2xl w-[92vw] shadow-2xl text-default dark:text-white">
    <div class="p-6 sm:p-8">
      <div class="flex justify-between items-center pb-4 mb-4 border-b border-[var(--cm-border)]">
        <div>
          <h3 class="text-2xl font-bold">Pro Specifications</h3>
          <p class="text-xs text-default/70 dark:text-gray-400">Advanced throughput for scaling teams and marketing agencies.</p>
        </div>
        <button type="button" class="close-modal p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-default/70 hover:text-default cursor-pointer">
          <Icon name="tabler:x" class="w-6 h-6" />
        </button>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-[var(--cm-border)] text-xs">
        <div><strong class="block text-default/60 dark:text-gray-400">Token Quota</strong> 10,000,000 tokens/month</div>
        <div><strong class="block text-default/60 dark:text-gray-400">Brand DNAs</strong> Up to 10 Brand DNAs</div>
        <div><strong class="block text-default/60 dark:text-gray-400">Workspaces</strong> 5 Isolated Workspaces</div>
        <div><strong class="block text-default/60 dark:text-gray-400">Concurrency</strong> 20 Concurrent Sessions</div>
        <div><strong class="block text-default/60 dark:text-gray-400">Storage</strong> 10 GB Secure Storage</div>
        <div><strong class="block text-default/60 dark:text-gray-400">AI Architecture</strong> Advanced Multi-Agent AI Engine</div>
      </div>

      <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--cm-primary)] mb-3">Included:</h4>
      <ul class="space-y-2 text-sm text-default/85 dark:text-gray-300">
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> 10,000,000 monthly tokens (7M input / 3M output)</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> Up to 10 Brand DNAs</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> 5 isolated workspaces with granular RBAC permissions</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> Up to 20 concurrent execution sessions</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> Advanced multi-agent autonomous reasoning</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> High-converting VSL, sales page & webinar scripts</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> 10 GB high-performance storage</li>
        <li class="flex items-start gap-2"><Icon name="tabler:check" class="w-4 h-4 text-[var(--cm-primary)] mt-0.5 flex-shrink-0" /> Priority model execution queue & priority support</li>
      </ul>

      <div class="mt-8 pt-4 border-t border-[var(--cm-border)] flex justify-end gap-3">
        <button type="button" class="close-modal px-4 py-2 rounded-lg text-sm font-semibold border border-[var(--cm-border)] hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer">Close</button>
        <a href="https://app.copymonster.co/" target="_blank" class="px-5 py-2 rounded-lg text-sm font-bold bg-[var(--cm-primary)] text-white hover:opacity-90">Subscribe to Pro</a>
      </div>
    </div>
  </dialog>

  <!-- 3. Legend Modal -->
  <dialog id="modal-legend" class="spec-dialog backdrop:bg-black/60 rounded-2xl p-0 border border-[var(--cm-border)] bg-[var(--cm-card)] max-w-2xl w-[92vw] shadow-2xl text-default dark:text-white">
    <div class="p-6 sm:p-8">
      <div class="flex justify-between items-center pb-4 mb-4 border-b border-[var(--cm-border)]">
        <div>
          <h3 class="text-2xl font-bold">Legend Specifications</h3>
          <p class="text-xs text-default/70 dark:text-gray-400">Dedicated infrastructure and unlimited capacity for holding portfolios.</p>
        </div>
        <button type="button" class="close-modal p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-default/70 hover:text-default cursor-pointer">
          <Icon name="tabler:x" class="w-6 h-6" />
        </button>
