---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pricing — CopyMonster',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Pricing"
    title="Choose the IQ of your Brand Identity"
    subtitle="Strategic plans designed to scale your brand intelligence from solopreneur to global enterprise."
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="Cloud Plans"
    subtitle="Optimized for speed and strategic growth"
    prices={[
      {
        title: 'Core (MIT)',
        subtitle: 'Devs, indies, self-hosted teams',
        price: 0,
        period: 'Forever',
        items: [
          { description: 'Access to core DNA engine' },
          { description: 'Community-driven updates' },
          { description: 'Self-hosting support' },
          { description: 'MIT License transparency' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Get on GitHub',
          href: 'https://github.com/Adriano-Digital2024/CopyMonster',
        },
      },
      {
        title: 'Starter Cloud',
        subtitle: 'Freelance copywriters',
        price: 47,
        period: 'Per Month',
        items: [
          { description: '1,000 credits per month' },
          { description: '1 Brand DNA (Active)' },
          { description: 'Access to all 8 AI agents' },
          { description: 'Positioning Diagnosis' },
          { description: 'AI Support Chat' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Start Free Trial',
          href: 'https://app.copymonster.co',
        },
      },
      {
        title: 'Pro Cloud',
        subtitle: 'Small agencies',
        price: 97,
        period: 'Per Month',
        items: [
          { description: '5,000 credits per month' },
          { description: 'Up to 10 Brand DNAs' },
          { description: 'Ads Intelligence Dashboard' },
          { description: 'Market Radar access' },
          { description: 'Priority AI Support' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Upgrade Now',
          href: 'https://app.copymonster.co',
        },
        hasRibbon: true,
        ribbonTitle: 'popular',
      },
    ]}
  />

  <!-- Enterprise & Scaling ******************* -->

  <Prices
    title="Enterprise & Scale"
    subtitle="High-performance solutions for large organizations"
    prices={[
      {
        title: 'Legend Cloud',
        subtitle: 'Mid-size agencies',
        price: 197,
        period: 'Per Month',
        items: [
          { description: '15,000 credits per month' },
          { description: 'Up to 50 Brand DNAs' },
          { description: 'Agent Training (Custom)' },
          { description: 'VIP WhatsApp Support' },
          { description: 'Early access to features' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Become a Legend',
          href: 'https://app.copymonster.co',
        },
      },
      {
        title: 'Enterprise Cloud',
        subtitle: 'Holdings, in-house teams',
        price: '1,500+',
        period: 'Per Month',
        items: [
          { description: 'Unlimited credits' },
          { description: 'Unlimited Brand DNAs' },
          { description: 'SSO & Advanced Security' },
          { description: 'Multi-tenant Workspaces' },
          { description: 'Dedicated account manager' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Contact Sales',
          href: 'https://app.copymonster.co',
        },
      },
      {
        title: 'Enterprise Self-Hosted',
        subtitle: 'Compliance / data-sensitive orgs',
        price: '8k–20k',
        period: 'Per Year',
        items: [
          { description: 'On-premise deployment' },
          { description: 'Full data sovereignty' },
          { description: 'Custom integration support' },
          { description: 'Annual maintenance included' },
          { description: 'SLA Guarantee' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Request Quote',
          href: 'https://app.copymonster.co',
        },
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="The Monster Advantage"
    subtitle="Why strategic intelligence beats generic prompting every time"
    columns={2}
    items={[
      {
        title: 'Permanent Strategic Memory',
        description: 'Your Brand DNA is versioned and saved, ensuring every agent knows your history and values.',
        icon: 'tabler:dna',
      },
      {
        title: 'Multi-Agent Orchestration',
        description: 'Deploy specialized agents for Ads, VSL, Email, and Social that all pull from the same brain.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Performance-Driven Evolution',
        description: 'Feed real performance data back into your DNA to evolve your brand identity automatically.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Enterprise-Grade Security',
        description: `Advanced SSO, multi-tenancy, and compliance-ready self-hosting options for sensitive data.`,
        icon: 'tabler:shield-lock',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Your 3-Step Journey to Brand Intelligence"
    tagline="simplified process"
    isReversed={true}
    items={[
      {
        title: 'Map your 12-block DNA',
        icon: 'tabler:number-1',
      },
      {
        title: 'Select your specialized agents',
        icon: 'tabler:number-2',
      },
      {
        title: 'Scale and evolve with real data',
        icon: 'tabler:number-3',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1536816579748-4ecb3f03d72a?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Strategy Workflow',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Pricing FAQs"
    subtitle="Everything you need to know about scaling your brand with CopyMonster."
    columns={1}
    items={[
      {
        title: 'What counts as a Brand DNA?',
        description:
          'A Brand DNA is a complete strategic map (12 blocks) for one product or business entity. You can have multiple versions of the same DNA.',
      },
      {
        title: 'How do credits work?',
        description:
          "Credits are consumed when you generate content or use the DNA Intelligence Engine. Higher plans offer significantly more volume.",
      },
      {
        title: 'Can I self-host CopyMonster?',
        description:
          'Yes! We are MIT licensed. The Core version is free to self-host. For enterprise-grade self-hosting with all features, contact our sales team.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Ready to scale your Brand DNA?"
    subtitle="Join thousands of entrepreneurs turning generic AI text into strategic intelligence."
    actions={[
      {
        variant: 'primary',
        text: 'Start Free Trial',
        href: 'https://app.copymonster.co',
      },
    ]}
  />
</Layout>
