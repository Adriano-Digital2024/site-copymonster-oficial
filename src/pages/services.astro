---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'AI Copywriting Software & Specialized Services — CopyMonster',
  description: 'Enterprise AI copywriting software powered by Brand DNA. Discover why CopyMonster outperforms generic tools like Jasper and Copy.ai.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget -->
  <HeroText
    tagline="AI Copywriting Software"
    title="Direct Response AI Software Anchored in Brand Identity"
    subtitle="Why settle for generic, robotic outputs? CopyMonster is the purpose-built copywriting engine that locks your Brand DNA into every word."
    callToAction={{
      variant: 'primary',
      text: 'Free Trial',
      href: 'https://app.copymonster.co/',
      target: '_blank',
      icon: 'tabler:robot',
    }}
    callToAction2={{
      text: 'View Pricing',
      href: getPermalink('/pricing'),
    }}
  />

  <!-- Visual Hero Showcase Image -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 -mt-6 mb-16 not-prose">
    <div class="section-image-wrapper overflow-hidden rounded-2xl border border-[var(--cm-border)] shadow-xl intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade">
      <img
        src="/images/site/AI%20copywriting%20software%20%E2%80%94%20Software%20de%20copywriting%20com%20IA.jpg"
        alt="AI Copywriting Software Overview"
        class="w-full h-auto object-cover transition-transform duration-500 hover:scale-105"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Features2 Widget: Specialized Copywriting Monsters -->
  <Features2
    title="20+ Specialized Copywriting Monsters"
    subtitle="Calibrated for every direct response touchpoint in your marketing ecosystem."
    columns={3}
    items={[
      {
        title: 'Video Sales Letters (VSLs)',
        description: 'Compelling psychological scripts built around problem agitation, core mechanism, and hard offers.',
        icon: 'tabler:video',
      },
      {
        title: 'High-Converting Sales Pages',
        description: 'Complete long-form sales pages with magnetic hooks, proof stacking, and bullet-proof guarantees.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'Direct Response Email Sequences',
        description: 'Soap opera stories, launch blitzes, flash sale urgency, and cart-recovery emails that print cash.',
        icon: 'tabler:mail',
      },
      {
        title: 'Meta & Google Ads Engine',
        description: 'Scroll-stopping creative angles, compliant copy variations, and magnetic headlines for paid traffic.',
        icon: 'tabler:ad',
      },
      {
        title: 'Lead Magnet & Opt-In Pages',
        description: 'Irresistible curiosity bullets that drive astronomical conversion rates on cold traffic opt-ins.',
        icon: 'tabler:magnet',
      },
      {
        title: 'High-Ticket Application Copy',
        description: 'Qualification surveys, pre-call booking pages, and vetting copy that filters for ideal clients.',
        icon: 'tabler:filter',
      },
    ]}
  />

  <!-- Content Widget: CopyMonster vs Jasper -->
  <Content
    isReversed
    tagline="Market Comparison"
    title="CopyMonster vs. Generic AI: The Brand DNA Difference"
    items={[
      {
        title: 'Beyond Disposable Prompts',
        description: 'Generic AI treats every conversation as day zero. CopyMonster stores an immutable 12-block Brand DNA that never fades.',
        icon: 'tabler:lock',
      },
      {
        title: 'Direct Response Precision',
        description: 'Trained on 15+ years of real conversion funnels, not bland corporate blog filler.',
        icon: 'tabler:target',
      },
      {
        title: 'Multi-Tenant Isolation',
        description: 'Strict database Row-Level Security (RLS) ensures agency clients and distinct brands never bleed into each other.',
        icon: 'tabler:shield-check',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-2">
        The Jasper & Copy.ai Alternative
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed mb-6">
        Tired of rewriting generic AI fluff? Switch to a deterministic engine designed to preserve your tone of voice, contrarian beliefs, and unique mechanisms.
      </p>
      <div class="section-image-wrapper overflow-hidden rounded-xl border border-[var(--cm-border)] shadow-md">
        <img
          src="/images/site/CopyMonster%20vs%20Jasper%20%E2%80%94%20CopyMonster%20vs%20Jasper.jpg"
          alt="CopyMonster vs Jasper Comparison"
          class="w-full h-auto object-cover transition-transform duration-500 hover:scale-105"
          loading="lazy"
        />
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[var(--cm-secondary)]/30 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget: Copy.ai Comparison -->
  <Content
    tagline="True Identity Scale"
    title="Stop Sounding Like Every Other Brand Using ChatGPT"
    items={[
      {
        title: 'Zero Sycophantic AI Tone',
        description: 'Eliminates words like delve, tapestry, revolutionize, and game-changer with automated vocabulary firewalls.',
        icon: 'tabler:ban',
      },
      {
        title: 'Real Mechanism Naming',
        description: 'Forces every offer to feature clear intellectual property mechanisms rather than vague promises.',
        icon: 'tabler:bulb',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight text-default dark:text-white sm:text-3xl mb-2">
        Distinctive Positioning at Scale
      </h3>
      <p class="text-default/80 dark:text-gray-300 leading-relaxed mb-6">
        In the age of infinite AI content, generic copy repels sophisticated buyers. Distinctive positioning and authentic voice are your only moats.
      </p>
      <div class="section-image-wrapper overflow-hidden rounded-xl border border-[var(--cm-border)] shadow-md">
        <img
          src="/images/site/CopyMonster%20vs%20Copy.ai%20%E2%80%94%20CopyMonster%20vs%20Copy.ai.jpg"
          alt="CopyMonster vs Copy.ai Architecture"
          class="w-full h-auto object-cover transition-transform duration-500 hover:scale-105"
          loading="lazy"
        />
      </div>
    </Fragment>
  </Content>

  <!-- Testimonials Widget -->
  <Testimonials
    title="Trusted by Elite Copywriters and Media Buyers"
    subtitle="See what operators say about switching from generic AI tools to CopyMonster."
    testimonials={[
      {
        testimonial:
          'CopyMonster finally solved our brand voice drift. Our team of 6 copywriters produces 3x more output and every draft sounds unmistakably like our founder.',
        name: 'Carlos Mendes',
        job: 'Direct Response Copy Chief',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80',
          alt: 'Carlos Mendes',
        },
      },
      {
        testimonial:
          'The 12-block Brand DNA framework cut our launch prep time from two weeks down to 48 hours. Our webinar conversion rate jumped 27% on the first run.',
        name: 'Amanda Rocha',
        job: 'Infoproduct Launch Strategist',
        image: {
          src: 'https://images.unsplash.com/photo-1561406636-b80293969660?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80',
          alt: 'Amanda Rocha',
        },
      },
      {
        testimonial:
          'We manage 18 clients. Switching between isolated Brand DNAs without re-prompting from scratch has saved us tens of thousands in wasted agency hours.',
        name: 'Roberto Silva',
        job: 'Growth Agency Founder',
        image: {
          src: 'https://images.unsplash.com/photo-1545167622-3a6ac756afa4?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80',
          alt: 'Roberto Silva',
        },
      },
    ]}
  />

  <!-- CallToAction Widget -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Free Trial',
        href: 'https://app.copymonster.co/',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      {
        text: 'View Plans & Pricing',
        href: getPermalink('/pricing'),
      },
    ]}
    title="Ready to Upgrade to Real Brand Intelligence?"
    subtitle="Start your 7-day trial now and experience autonomous multi-agent copywriting with zero prompt drift."
  />
</Layout>
