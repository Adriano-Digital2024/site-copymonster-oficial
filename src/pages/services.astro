---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'AI Agents & Services — CopyMonster',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="AI Agents"
    title="Select a Monster to start creating"
    subtitle="Our specialized AI agents are trained on your Brand DNA to ensure every word aligns with your unique identity and strategic goals."
    actions={[{ variant: 'primary', target: '_blank', text: 'Launch App', href: 'https://app.copymonster.co' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'AI Agent Orchestra',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Copywriting Monsters"
    subtitle="20+ Specialized agents for every digital touchpoint"
    columns={3}
    items={[
      {
        title: 'Blog Posts Monster',
        description: 'SEO-friendly articles that rank and engage readers.',
        icon: 'tabler:article',
      },
      {
        title: 'Email Marketing Monster',
        description: 'High-converting emails that build trust and drive clicks.',
        icon: 'tabler:mail',
      },
      {
        title: 'Social Media Monster',
        description: 'Strategic posts for Instagram, LinkedIn, and TikTok from your DNA.',
        icon: 'tabler:brand-instagram',
      },
      {
        title: 'Video Scripts Monster',
        description: 'Engaging scripts for VSLs and short-form videos.',
        icon: 'tabler:video',
      },
      {
        title: 'Google & Facebook Ads',
        description: 'Expertly optimized copy for SEM and social advertising.',
        icon: 'tabler:brand-google-filled',
      },
      {
        title: 'Landing Pages Monster',
        description: 'High-conversion page copy structured for results.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'Headline Monster',
        description: 'Magnetic headlines that capture attention instantly.',
        icon: 'tabler:typography',
      },
      {
        title: 'WhatsApp Sales Monster',
        description: 'Persuasive sales sequences for direct messaging.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Strategic Stories Monster',
        description: 'Authority-building narratives for social stories.',
        icon: 'tabler:camera-rotate',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Campaigns"
    title="Complete Campaign Monsters"
    subtitle="Ready-to-use campaigns with all assets included. Strategy, Content, and Performance in one click."
    items={[
      {
        title: 'Internal Launch Monster',
        description: '7-day sequence with all emails and scripts.',
      },
      {
        title: 'Evergreen Funnel Monster',
        description: 'Automated funnel that sells 24/7.',
      },
      {
        title: 'Flash Launch Monster',
        description: '3-day maximum urgency sequence.',
      },
      {
        title: 'Webinar Campaign Monster',
        description: 'Complete invite and sales pitch sequence.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: 'Strategic Campaigns',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Orchestrated Results</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Strategic Efficiency',
        description:
          'Our agents don\'t just write; they think using your Brand DNA. This reduces editing time by 90% and ensures consistency.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Agency-Ready Scaling',
        description:
          'Switch between multiple Brand DNAs effortlessly. Scale your agency production without losing brand integrity.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Open Source Trust',
        description:
          'The core engine is MIT licensed. Self-host for maximum privacy and customize the specialized agents to your needs.',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Real-World Performance',
        description:
          'Integrated with Meta Ads performance loops. Your brand identity becomes smarter with every dollar spent.',
        icon: 'tabler:chart-bar',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Monster Efficiency',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Why it works</h3>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Monster Success Stories"
    testimonials={[
      {
        testimonial: `CopyMonster finally solved my generic copy problem. By mapping my Brand DNA first, the AI agents now speak exactly like I do. It's like having a strategic clone that works 24/7.`,
        name: 'Carlos Mendes',
        job: 'Direct Response Copywriter',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Carlos Mendes',
        },
      },
      {
        testimonial: `The 12-block strategic map is a game changer for my SaaS. I used to spend hours tweaking prompts; now I just lock the DNA and deploy agents for my entire funnel in minutes.`,
        name: 'Amanda Rocha',
        job: 'Founder, Tech Startup',
        image: {
          src: 'https://images.unsplash.com/photo-1561406636-b80293969660?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Amanda Rocha',
        },
      },
      {
        testimonial: `As a marketing agency, consistency was our biggest nightmare. CopyMonster unified our brand intelligence across all clients. The Enterprise DNA Engine is absolute magic.`,
        name: 'Roberto Silva',
        job: 'Agency Director',
        image: {
          src: 'https://images.unsplash.com/photo-1545167622-3a6ac756afa4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=824&q=80',
          alt: 'Roberto Silva',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'Free Trial',
      href: 'https://app.copymonster.co/',
      icon: 'tabler:chevron-right',
    }}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start Branding',
        href: 'https://app.copymonster.co',
      },
    ]}
    title="Ready to unleash the Monsters?"
    subtitle="Join the 21K+ community building high-performance digital assets on top of strategic DNA."
  />
</Layout>
