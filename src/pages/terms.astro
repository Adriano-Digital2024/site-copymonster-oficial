---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/Headline.astro';

const metadata = {
  title: 'Terms of Service — CopyMonster',
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <HeroText title="Terms of Service" subtitle="Last Updated: July 12, 2026" />
    
    <div
      class="mx-auto prose prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8"
    >
      <h2>1. ACCEPTANCE OF TERMS</h2>
      <p>
        These Terms of Service ("Terms") constitute a legally binding agreement between you and Integridade Digital Marketing, headquartered in São Paulo, Brazil ("CopyMonster", "we", "us"). By accessing or using our Brand DNA Operating System, AI Agents, Market Radar, and associated services (the "Services"), you agree to be bound by these Terms. If you are using the Services on behalf of an organization, you represent that you have the authority to bind that organization.
      </p>

      <h2>2. ACCOUNTS & SECURITY</h2>
